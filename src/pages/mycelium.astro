---
// The Mycelium version: the same Silo, drawn as four nodes on one network.
// Shares the top bar, title, banner and silo panels with the Silo version (/).
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Masthead from '../components/Masthead.astro';
import Panels from '../components/Panels.astro';
import Mycelium from '../components/Mycelium.astro';
---

<Base title="Silo (mycelium)">
  <TopBar />

  <main class="site-main">
    <Masthead />
    <Mycelium />
  </main>

  <Panels silos={false} />
</Base>
