---
import Base from '../layouts/Base.astro';
import { pillars, label, banner, social, about } from '../data/catalog';
import PlaceMap from '../components/PlaceMap.astro';
import SocialIcon from '../components/SocialIcon.astro';

const socialMenus = [
  { id: 'instagram' as const, title: 'Instagram', accounts: social.instagram },
  { id: 'twitter' as const, title: 'X / Twitter', accounts: social.twitter },
];

// A silo's own Instagram / X account, looked up by name in `social`.
const accountFor = (menu: (typeof socialMenus)[number], name: string) =>
  menu.accounts.find((a) => a.name === name);

// Enough copies that one group is wider than any screen; the track holds two
// groups and slides left by exactly one, so the loop has no seam.
const copies = Array.from({ length: 8 });
const isExternal = (url?: string) => !!url?.startsWith('http');
---

<Base>
  <div class="top">
    {
      socialMenus.map((m) => (
        <div class="menu">
          <button
            class="top-link icon-link"
            type="button"
            aria-expanded="false"
            aria-controls={`${m.id}-panel`}
            aria-label={m.title}
          >
            <SocialIcon kind={m.id} />
          </button>
          <div class="drop social-panel" id={`${m.id}-panel`} hidden>
            <p class="sub-title">{m.title}</p>
            <ul class="accounts">
              {m.accounts.map((a) => (
                <li data-pillar={a.key}>
                  {a.url ? (
                    <a class="acct" href={a.url} target="_blank" rel="noopener">
                      <span class="acct-name">{a.name}</span>
                      <span class="acct-handle">{a.handle ?? ''} ↗</span>
                    </a>
                  ) : (
                    <span class="acct soon-acct">
                      <span class="acct-name">{a.name}</span>
                      <span class="acct-handle">Soon</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }

    <div class="menu">
      <button
        class="top-link"
        type="button"
        id="sub-toggle"
        aria-expanded="false"
        aria-controls="sub-panel"
      >
        Subscribe<span class="caret" aria-hidden="true">↓</span>
      </button>

      {/* Placeholder: no newsletter service yet, so this sends nothing. */}
      <form class="drop sub-panel" id="sub-panel" hidden novalidate>
        <p class="sub-title">Get updates by email</p>
        <fieldset>
          <legend class="sr">What would you like to hear about?</legend>
          <label class="opt" data-pillar="all">
            <input type="checkbox" name="list" value="all" data-all />
            <span class="box" aria-hidden="true"></span>
            All Silo updates
          </label>
          <label class="opt" data-pillar="recording">
            <input type="checkbox" name="list" value="recording" data-one />
            <span class="box" aria-hidden="true"></span>
            Silo Recording
          </label>
          <label class="opt" data-pillar="decamp">
            <input type="checkbox" name="list" value="decamp" data-one />
            <span class="box" aria-hidden="true"></span>
            DeCamp
          </label>
          <label class="opt" data-pillar="label">
            <input type="checkbox" name="list" value="label" data-one />
            <span class="box" aria-hidden="true"></span>
            Software Label
          </label>
        </fieldset>
        <label class="sr" for="sub-email">Email address</label>
        <div class="sub-row">
          <input
            id="sub-email"
            type="email"
            name="email"
            placeholder="you@email.com"
            autocomplete="email"
            required
          />
          <button type="submit">Sign up</button>
        </div>
        <p class="sub-note" role="status"></p>
      </form>
    </div>

    <a class="top-link" href={`mailto:${label.contact}`}>Contact↗</a>
  </div>

  <main>
    {/* The title is the way into About. */}
    <h1>
      <button
        class="row about-btn"
        type="button"
        data-open="silo-about"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Silo: about us"
      >
        <span class="tag"><i>About</i>↗</span>
        <span class="name">Silo</span>
      </button>
    </h1>

    <a class="ticker" href={banner.url}>
      <span class="sr">{banner.text}</span>
      <span class="track" aria-hidden="true">
        {
          [0, 1].map(() => (
            <span class="group">
              {copies.map(() => (
                <span class="msg">
                  {banner.text}
                  <span class="sep">///</span>
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </a>

    {/* The chosen form: ring layout, ink look. The CSS still has "row" and
        "cluster" layouts and a "glow" look, should these ever change. */}
    <div class="stage" data-arrange="ring" data-look="ink">
      <ul class="silos">
        {
          pillars.map((p, i) => (
            <li data-pillar={p.key} class={`s${i + 1}`}>
              <button
                class="silo"
                type="button"
                data-open={`silo-${p.key}`}
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label={p.name}
              >
                <span class="disc">
                  {/* Placeholder marks from the brand kit (round 3). */}
                  <img class="mark" src={`/silo/marks/${p.key}.svg`} alt="" width="400" height="400" />
                  {/* The name set around the circle's edge, once along the top
                      and once along the bottom (so it never reads upside
                      down). Each layout shows one and turns it to face out. */}
                  <svg class="arc" viewBox="0 0 100 100" aria-hidden="true">
                    <path id={`arc-top-${p.key}`} d="M 12 50 A 38 38 0 0 1 88 50" fill="none" />
                    <path id={`arc-bot-${p.key}`} d="M 5.5 50 A 44.5 44.5 0 0 0 94.5 50" fill="none" />
                    <text class="arc-top">
                      <textPath href={`#arc-top-${p.key}`} startOffset="50%" text-anchor="middle">
                        {p.name}
                      </textPath>
                    </text>
                    <text class="arc-bot">
                      <textPath href={`#arc-bot-${p.key}`} startOffset="50%" text-anchor="middle">
                        {p.name}
                      </textPath>
                    </text>
                  </svg>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      {/* Names under the stack. Mouse-only duplicates of the circles, so
          screen readers and keyboards skip them. */}
      <ol class="legend" aria-hidden="true">
        {
          pillars.map((p, i) => (
            <li data-pillar={p.key}>
              <button type="button" tabindex="-1" data-open-via={`silo-${p.key}`}>
                <span class="no">#{String(i + 1).padStart(2, '0')}</span>
                {p.name}
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </main>

  {/* ---------- About: opens from the SILO title ---------- */}
  <dialog class="panel" id="silo-about" data-pillar="about" aria-labelledby="silo-about-title">
    <div class="inner">
      <button class="close" type="button" data-close>
        Close ✕
      </button>

      <h2 class="panel-title row" id="silo-about-title">
        <span class="tag"><i>est</i>{label.year}</span>
        <span class="name">About Silo</span>
      </h2>

      <div class="about-body">
        {about.summary.map((t) => <p class="about-lede">{t}</p>)}
      </div>

      <section class="about-sec">
        <h3 class="about-h">The four silos</h3>
        <ol class="about-silos">
          {
            pillars.map((p, i) => (
              <li data-pillar={p.key}>
                <span class="swatch" aria-hidden="true" />
                <span class="about-silo-no">#{String(i + 1).padStart(2, '0')}</span>
                <span class="about-silo-name">{p.name}</span>
                <span class="about-silo-desc">{p.desc}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="about-sec">
        <h3 class="about-h">Team</h3>
        <ul class="team">
          {
            about.team.map((m) => (
              <li>
                <p class="team-name">{m.name}</p>
                <p class="team-role">{m.role}</p>
                <p class="team-bio">{m.bio}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </dialog>

  {
    pillars.map((p, i) => (
      <dialog class="panel" id={`silo-${p.key}`} data-pillar={p.key} aria-labelledby={`silo-${p.key}-title`}>
        <div class="inner">
          <button class="close" type="button" data-close>
            Close ✕
          </button>

          <h2 class="panel-title row" id={`silo-${p.key}-title`}>
            <span class="tag">
              <i>#</i>
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="name">{p.name}</span>
          </h2>

          <div class="panel-intro">
            <p class="panel-desc">{p.desc}</p>

            {/* Sign up and follow, just for this silo. Placeholder: sends nothing yet. */}
            <div class="optin">
              <form class="optin-form" novalidate>
                <p class="optin-title">Get {p.name} updates</p>
                <input type="hidden" name="list" value={p.key} />
                <label class="sr" for={`optin-${p.key}`}>Email address</label>
                <div class="optin-row">
                  <input
                    id={`optin-${p.key}`}
                    type="email"
                    name="email"
                    placeholder="you@email.com"
                    autocomplete="email"
                    required
                  />
                  <button type="submit">Sign up</button>
                </div>
                <p class="optin-note" role="status"></p>
              </form>

              <div class="follow">
                <span class="follow-label">Follow</span>
                {socialMenus.map((m) => {
                  const acct = accountFor(m, p.socialName);
                  const name = `${p.socialName} on ${m.title}`;
                  return acct?.url ? (
                    <a class="follow-icon" href={acct.url} target="_blank" rel="noopener" aria-label={name}>
                      <SocialIcon kind={m.id} />
                    </a>
                  ) : (
                    <span class="follow-icon soon-icon" role="img" aria-label={`${name}, coming soon`} title="Coming soon">
                      <SocialIcon kind={m.id} />
                    </span>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Silos whose items are places (DeCamp) get a map; the rest a list. */}
          {p.items.some((it) => it.at) ? (
            <PlaceMap id={`silo-${p.key}`} items={p.items} />
          ) : (
          <ul class="items">
            {p.items.map((it) => {
              const Tag = it.soon || !it.url ? 'span' : 'a';
              return (
                <li>
                  <Tag
                    class:list={['item', { soon: it.soon }]}
                    href={Tag === 'a' ? it.url : undefined}
                    target={Tag === 'a' && isExternal(it.url) ? '_blank' : undefined}
                    rel={Tag === 'a' && isExternal(it.url) ? 'noopener' : undefined}
                  >
                    <span class="row item-head">
                      <span class="tag">
                        <i>#</i>
                        {it.no}
                      </span>
                      <span class="item-name">
                        {it.name}
                        {Tag === 'a' && <span class="arr">↗</span>}
                      </span>
                    </span>
                    <span class="item-desc">{it.soon ? `Soon. ${it.desc}` : it.desc}</span>
                  </Tag>
                </li>
              );
            })}
          </ul>
          )}

          {p.url && (
            <a class="more" href={p.url}>
              {p.urlLabel ?? 'More'} ↗
            </a>
          )}
        </div>
      </dialog>
    ))
  }
</Base>

<script>
  // Each silo opens as a circle that grows out of the one you clicked until it
  // fills the screen, then closes back into it. Everything is set through the
  // Web Animations API, so the CSP never has to allow inline styles.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.76, 0, 0.24, 1)';

  // The button a panel opens from: a silo circle, or the SILO title for About.
  const circleBtn = (id: string) => document.querySelector<HTMLElement>(`[data-open="${id}"]`)!;

  function circles(btn: HTMLElement) {
    // Grow from the silo's circle, or from the middle of the title.
    const r = (btn.querySelector('.disc, .name') ?? btn).getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const far = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    return {
      small: `circle(${Math.min(r.width, r.height) / 2}px at ${x}px ${y}px)`,
      big: `circle(${far}px at ${x}px ${y}px)`,
    };
  }

  function open(btn: HTMLElement) {
    const panel = document.getElementById(btn.dataset.open!) as HTMLDialogElement;
    panel.showModal();
    panel.scrollTop = 0;
    document.documentElement.classList.add('locked');
    btn.setAttribute('aria-expanded', 'true');
    if (reduce.matches) return;

    const c = circles(btn);
    panel.animate({ clipPath: [c.small, c.big] }, { duration: 750, easing: ease });
    panel.querySelector('.inner')!.animate(
      { opacity: [0, 1], transform: ['translateY(28px)', 'none'] },
      { duration: 450, delay: 380, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fill: 'backwards' },
    );
  }

  async function close(panel: HTMLDialogElement) {
    if (panel.dataset.closing) return;
    panel.dataset.closing = '1';
    const btn = circleBtn(panel.id);

    if (!reduce.matches) {
      const c = circles(btn);
      panel.querySelector('.inner')!.animate({ opacity: [1, 0] }, { duration: 160, fill: 'forwards' });
      await panel.animate({ clipPath: [c.big, c.small] }, { duration: 600, easing: ease, fill: 'forwards' })
        .finished;
    }

    panel.close();
    panel.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    delete panel.dataset.closing;
    document.documentElement.classList.remove('locked');
    btn.setAttribute('aria-expanded', 'false');
    btn.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => open(btn));
  });
  // ---------- Top-right dropdowns (Instagram, X, Subscribe) ----------
  // One open at a time; click outside or press Escape to close.
  const toggles = [...document.querySelectorAll<HTMLElement>('.top [aria-controls]')];
  const panelOf = (t: HTMLElement) => document.getElementById(t.getAttribute('aria-controls')!)!;

  function setMenu(toggle: HTMLElement, open: boolean) {
    toggles.forEach((t) => {
      const show = t === toggle && open;
      panelOf(t).hidden = !show;
      t.setAttribute('aria-expanded', String(show));
    });
    if (open) panelOf(toggle).querySelector<HTMLElement>('input, a')?.focus();
  }
  toggles.forEach((t) => t.addEventListener('click', () => setMenu(t, panelOf(t).hidden)));
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.menu')) toggles.forEach((t) => setMenu(t, false));
  });
  document.querySelectorAll<HTMLElement>('.top .drop').forEach((panel) =>
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const t = toggles.find((x) => panelOf(x) === panel)!;
      setMenu(t, false);
      t.focus();
    }),
  );

  // ---------- Subscribe form ----------
  const subPanel = document.getElementById('sub-panel') as HTMLFormElement;
  const note = subPanel.querySelector<HTMLElement>('.sub-note')!;
  const allBox = subPanel.querySelector<HTMLInputElement>('[data-all]')!;
  const oneBoxes = [...subPanel.querySelectorAll<HTMLInputElement>('[data-one]')];

  // "All Silo updates" ticks every list; unticking any one list unticks "All".
  allBox.addEventListener('change', () => oneBoxes.forEach((b) => (b.checked = allBox.checked)));
  oneBoxes.forEach((b) =>
    b.addEventListener('change', () => (allBox.checked = oneBoxes.every((x) => x.checked))),
  );

  subPanel.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = subPanel.querySelector<HTMLInputElement>('#sub-email')!;
    if (!oneBoxes.some((b) => b.checked)) {
      note.textContent = 'Pick at least one thing to hear about.';
    } else if (!email.checkValidity()) {
      note.textContent = 'That email address doesn’t look right.';
      email.focus();
    } else {
      // TODO: send to the newsletter service once one is chosen.
      note.textContent = 'Thanks! Sign-ups aren’t live yet, so nothing was sent.';
    }
  });

  // ---------- Per-silo sign-up forms (inside each open silo) ----------
  document.querySelectorAll<HTMLFormElement>('.optin-form').forEach((form) => {
    const out = form.querySelector<HTMLElement>('.optin-note')!;
    const email = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!email.checkValidity()) {
        out.textContent = 'That email address doesn’t look right.';
        email.focus();
      } else {
        // TODO: send to the newsletter service (list: form.list.value) once one is chosen.
        out.textContent = 'Thanks! Sign-ups aren’t live yet, so nothing was sent.';
      }
    });
  });

  // Clicking a name under the stack opens its silo out of the circle.
  document.querySelectorAll<HTMLElement>('[data-open-via]').forEach((btn) => {
    btn.addEventListener('click', () => open(circleBtn(btn.dataset.openVia!)));
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.panel').forEach((panel) => {
    // Escape key
    panel.addEventListener('cancel', (e) => {
      e.preventDefault();
      close(panel);
    });
    panel.querySelector('[data-close]')!.addEventListener('click', () => close(panel));
  });
</script>

<style>
  :global(body) {
    container-type: inline-size;
  }
  :global(html.locked) {
    overflow: hidden;
  }

  /* Size the title so it matches the original list's scale. */
  main {
    padding: 12px 16px 48px;
    font-size: calc((100cqw - 60px) / 11);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* Pillar colours live here, not in style="" attributes, so the CSP
     doesn't need to allow inline styles. */
  [data-pillar='recording'] {
    --c: #ff5b26;
  }
  [data-pillar='decamp'] {
    --c: #e9dcb8;
  }
  [data-pillar='creators'] {
    --c: #a6d96a;
  }
  [data-pillar='label'] {
    --c: #8fa8ff;
  }
  /* "All" (Silo itself) in the top-right dropdowns stays white */
  [data-pillar='all'] {
    --c: var(--fg);
  }

  h1,
  h2,
  p,
  ul {
    margin: 0;
    padding: 0;
    font: inherit;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.3em;
  }

  /* the little stacked "#" + number to the left of a line */
  .tag {
    flex: none;
    width: 1.7rem;
    display: flex;
    flex-direction: column;
    font-size: 11px;
    line-height: 1;
    color: var(--dim);
    font-variation-settings: 'wdth' 100;
    align-self: flex-end;
    padding-bottom: 0.15em;
  }
  .tag i {
    font-style: normal;
    font-size: 9px;
  }

  h1 {
    color: var(--fg);
  }

  /* the SILO title doubles as the About button */
  .about-btn {
    all: unset;
    display: flex;
    cursor: pointer;
  }
  .about-btn .tag {
    width: auto;
    min-width: 1.7rem;
    transition: color 0.2s;
  }
  .about-btn .name {
    transition: color 0.2s;
  }
  .about-btn:hover .tag,
  .about-btn:focus-visible .tag {
    color: var(--fg);
  }
  .about-btn:hover .name {
    color: #d9d9d9;
  }
  .about-btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  /* ---------- About panel (white) ---------- */
  [data-pillar='about'] {
    --c: var(--fg);
  }
  .about-body {
    margin-top: clamp(16px, 2.5vw, 36px);
    max-width: 40ch;
  }
  .about-lede {
    font-size: clamp(18px, 2.2vw, 32px);
    font-weight: 600;
    line-height: 1.3;
    font-variation-settings: 'wdth' 100;
  }
  .about-lede + .about-lede {
    margin-top: 0.8em;
  }
  .about-sec {
    margin-top: clamp(36px, 5vw, 72px);
    padding-top: 14px;
    border-top: 2px solid var(--bg);
  }
  .about-h {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
  }
  .about-silos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-silos li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c);
    border: 2px solid var(--bg);
    margin-bottom: 4px;
  }
  .about-silo-no {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.6;
    font-variation-settings: 'wdth' 100;
  }
  .about-silo-name {
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .about-silo-desc {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    font-variation-settings: 'wdth' 100;
  }
  .team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .team-name {
    font-size: clamp(28px, 3.4vw, 52px);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .team-role {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
    opacity: 0.6;
  }
  .team-bio {
    margin-top: 10px;
    max-width: 42ch;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
    font-variation-settings: 'wdth' 100;
  }
  @media (max-width: 900px) {
    .about-silos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .about-silos,
    .team {
      grid-template-columns: 1fr;
    }
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- scrolling banner ---------- */
  .ticker {
    display: block;
    margin: 0.2em -16px 0;
    overflow: hidden;
    background: var(--fg);
    color: var(--bg);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
