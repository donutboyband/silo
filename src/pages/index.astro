---
import Base from '../layouts/Base.astro';
import { pillars, label } from '../data/catalog';
---

<Base>
  <a class="contact" href={`mailto:${label.contact}`}>Contact↗</a>

  <main>
    <h1 class="row">
      <span class="tag"><i>est</i>{label.year}</span>
      <span class="name">Silo</span>
    </h1>

    {
      pillars.map((p) => (
        <section data-pillar={p.key}>
          <h2 class="row head">
            <span class="tag slash">///</span>
            <span class="name">{p.name}</span>
          </h2>
          <ul>
            {p.items.map((it) => {
              const Tag = it.soon || !it.url ? 'span' : 'a';
              return (
                <li>
                  <Tag
                    class:list={['row', 'item', { soon: it.soon }]}
                    href={Tag === 'a' ? it.url : undefined}
                    target={Tag === 'a' && it.url?.startsWith('http') ? '_blank' : undefined}
                    rel={Tag === 'a' && it.url?.startsWith('http') ? 'noopener' : undefined}
                  >
                    <span class="tag">
                      <i>#</i>
                      {it.no}
                    </span>
                    <span class="name">
                      {it.name}
                      {Tag === 'a' && <span class="arr">↗</span>}
                    </span>
                    <span class="desc">{it.soon ? `Soon. ${it.desc}` : it.desc}</span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <p class="row next" aria-label="More soon">
      <span class="tag"><i>#</i>?</span>
      <span class="name"><span class="cursor"></span></span>
    </p>
  </main>
</Base>

<style>
  :global(body) {
    container-type: inline-size;
  }

  /* Size the type so the longest line ("Tools for Creators", 18 chars at
     0.6em each, plus the tag column) runs edge to edge at any width. */
  main {
    padding: 12px 16px 48px;
    font-size: calc((100cqw - 60px) / 11);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* Pillar colours live here, not in style="" attributes, so the CSP
     doesn't need to allow inline styles. */
  [data-pillar='recording'] {
    --c: #ff5b26;
  }
  [data-pillar='decamp'] {
    --c: #e9dcb8;
  }
  [data-pillar='creators'] {
    --c: #a6d96a;
  }
  [data-pillar='label'] {
    --c: #8fa8ff;
  }

  h1,
  h2,
  p,
  ul {
    margin: 0;
    padding: 0;
    font: inherit;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.3em;
  }

  /* the little stacked "#" + number to the left of every line */
  .tag {
    flex: none;
    width: 1.7rem;
    display: flex;
    flex-direction: column;
    font-size: 11px;
    line-height: 1;
    color: var(--dim);
    font-variation-settings: 'wdth' 100;
    align-self: flex-end;
    padding-bottom: 0.15em;
  }
  .tag i {
    font-style: normal;
    font-size: 9px;
  }

  h1 {
    color: var(--fg);
  }

  .head {
    color: var(--c);
    margin-top: 0.35em;
  }
  .slash {
    color: var(--c);
    font-size: 13px;
    align-self: center;
    padding: 0;
  }

  .item {
    transition: color 0.1s;
  }
  .arr {
    visibility: hidden;
    font-size: 0.7em;
  }
  .desc {
    font-size: clamp(12px, 1.2cqw, 18px);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    font-variation-settings: 'wdth' 100;
    color: var(--c);
  }

  a.item:hover,
  a.item:focus-visible {
    color: var(--fg);
  }
  .item:hover .arr,
  .item:focus-visible .arr {
    visibility: visible;
  }

  /* With a mouse, the description is a caption pinned to the bottom-right
     corner, so hovering never moves the list. */
  @media (hover: hover) {
    .desc {
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 2;
      width: min(38ch, calc(100vw - 32px));
      padding: 0.9em 1.1em 1em;
      font-size: clamp(16px, 1.55cqw, 26px);
      font-weight: 600;
      line-height: 1.28;
      background: var(--c);
      color: var(--bg);
      box-shadow: 8px 8px 0 var(--fg);
      visibility: hidden;
    }
    .item:hover .desc,
    .item:focus-visible .desc {
      visibility: visible;
    }
  }

  /* touch screens can't hover: show the one-liner under each name */
  @media (hover: none) {
    .desc {
      flex-basis: 100%;
      padding: 0 0 0.5em calc(1.7rem + 0.3em);
    }
    .arr {
      visibility: visible;
    }
  }

  .soon {
    color: var(--faint);
  }

  .next {
    margin-top: 0.35em;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.8em;
    background: var(--dim);
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .contact {
    position: fixed;
    top: 12px;
    right: 16px;
    z-index: 2;
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--dim);
    background: var(--bg);
    padding: 0 0 4px 8px;
  }
  .contact:hover {
    color: var(--fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
