---
import Base from '../layouts/Base.astro';
import { pillars } from '../data/catalog';
import TopBar from '../components/TopBar.astro';
import Masthead from '../components/Masthead.astro';
import Panels from '../components/Panels.astro';
---

{/* The Silo version: four overlapping silos in a ring. */}
<Base>
  <TopBar />

  <main class="site-main">
    <Masthead />

    {/* The chosen form: ring layout, ink look. The CSS still has "row" and
        "cluster" layouts and a "glow" look, should these ever change. */}
    <div class="stage" data-arrange="ring" data-look="ink">
      <ul class="silos">
        {
          pillars.map((p, i) => (
            <li data-pillar={p.key} class={`s${i + 1}`}>
              <button
                class="silo"
                type="button"
                data-open={`silo-${p.key}`}
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label={p.name}
              >
                <span class="disc">
                  {/* Placeholder marks from the brand kit (round 3). */}
                  <img class="mark" src={`/silo/marks/${p.key}.svg`} alt="" width="400" height="400" />
                  {/* The name set around the circle's edge, once along the top
                      and once along the bottom (so it never reads upside
                      down). Each layout shows one and turns it to face out. */}
                  <svg class="arc" viewBox="0 0 100 100" aria-hidden="true">
                    <path id={`arc-top-${p.key}`} d="M 12 50 A 38 38 0 0 1 88 50" fill="none" />
                    <path id={`arc-bot-${p.key}`} d="M 5.5 50 A 44.5 44.5 0 0 0 94.5 50" fill="none" />
                    <text class="arc-top">
                      <textPath href={`#arc-top-${p.key}`} startOffset="50%" text-anchor="middle">
                        {p.name}
                      </textPath>
                    </text>
                    <text class="arc-bot">
                      <textPath href={`#arc-bot-${p.key}`} startOffset="50%" text-anchor="middle">
                        {p.name}
                      </textPath>
                    </text>
                  </svg>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      {/* Names under the stack. Mouse-only duplicates of the circles, so
          screen readers and keyboards skip them. */}
      <ol class="legend" aria-hidden="true">
        {
          pillars.map((p, i) => (
            <li data-pillar={p.key}>
              <button type="button" tabindex="-1" data-open-via={`silo-${p.key}`}>
                <span class="no">#{String(i + 1).padStart(2, '0')}</span>
                {p.name}
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </main>

  <Panels />
</Base>

<style>
  /* ---------- the four silos, overlapping ---------- */
  .stage {
    margin-top: clamp(28px, 4cqw, 64px);
  }
  .silos {
    position: relative;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    transition: width 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  /* Every circle is placed in % of the stack, so switching layouts glides. */
  .silos li {
    position: absolute;
    transition:
      left 0.6s cubic-bezier(0.76, 0, 0.24, 1),
      top 0.6s cubic-bezier(0.76, 0, 0.24, 1),
      width 0.6s cubic-bezier(0.76, 0, 0.24, 1),
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Row: four across, each tucked over the last (the slatted-circles mood). */
  [data-arrange='row'] .silos {
    width: min(100%, 1100px);
    aspect-ratio: 100 / 34;
  }
  [data-arrange='row'] .silos li {
    width: 34%;
    top: 0;
  }
  [data-arrange='row'] .silos .s1 { left: 0; }
  [data-arrange='row'] .silos .s2 { left: 22%; }
  [data-arrange='row'] .silos .s3 { left: 44%; }
  [data-arrange='row'] .silos .s4 { left: 66%; }

  /* Cluster: a 2x2 seen from above, all four sharing the middle. */
  [data-arrange='cluster'] .silos {
    width: min(100%, 560px);
    aspect-ratio: 1;
  }
  [data-arrange='cluster'] .silos li { width: 58%; }
  [data-arrange='cluster'] .silos .s1 { left: 0; top: 0; }
  [data-arrange='cluster'] .silos .s2 { left: 42%; top: 0; }
  [data-arrange='cluster'] .silos .s3 { left: 0; top: 42%; }
  [data-arrange='cluster'] .silos .s4 { left: 42%; top: 42%; }

  /* Ring: four around a shared centre. */
  [data-arrange='ring'] .silos {
    width: min(100%, 560px);
    aspect-ratio: 1;
  }
  [data-arrange='ring'] .silos li { width: 50%; }
  [data-arrange='ring'] .silos .s1 { left: 25%; top: 0; }
  [data-arrange='ring'] .silos .s2 { left: 50%; top: 25%; }
  [data-arrange='ring'] .silos .s3 { left: 25%; top: 50%; }
  [data-arrange='ring'] .silos .s4 { left: 0; top: 25%; }

  .silo {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
    border-radius: 50%;
  }
  .silo:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }
  .disc {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    transition: box-shadow 0.35s;
  }
  .mark {
    position: absolute;
    inset: 21%;
    width: 58%;
    height: 58%;
  }

  /* ---------- names around the edge ---------- */
  .arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transition: rotate 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .arc text {
    font-family: var(--f-mono);
    font-size: 7.4px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
    fill: var(--bg);
  }
  /* By default the name runs along the top; layouts below override. */
  .arc-bot {
    display: none;
  }

  /* Row: circles only touch at the sides, so every name sits on top. */

  /* Cluster: each name on its outer corner. */
  [data-arrange='cluster'] .s1 .arc { rotate: -45deg; }
  [data-arrange='cluster'] .s2 .arc { rotate: 45deg; }
  [data-arrange='cluster'] .s3 .arc { rotate: 45deg; }
  [data-arrange='cluster'] .s4 .arc { rotate: -45deg; }
  [data-arrange='cluster'] .s3 .arc-top,
  [data-arrange='cluster'] .s4 .arc-top { display: none; }
  [data-arrange='cluster'] .s3 .arc-bot,
  [data-arrange='cluster'] .s4 .arc-bot { display: inline; }

  /* Ring: each name on the side facing away from the centre. */
  [data-arrange='ring'] .s2 .arc { rotate: 90deg; }
  [data-arrange='ring'] .s4 .arc { rotate: -90deg; }
  [data-arrange='ring'] .s3 .arc-top { display: none; }
  [data-arrange='ring'] .s3 .arc-bot { display: inline; }

  /* Glow (screen): solid colour cut by dark slats, a black seam where one
     circle crosses the next, and a soft halo. */
  [data-look='glow'] .disc {
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 9.5%,
        rgb(0 0 0 / 0.82) 9.5% 11.5%
      ),
      var(--c);
    box-shadow:
      0 0 0 clamp(2px, 0.4cqw, 5px) var(--bg),
      0 0 clamp(18px, 3cqw, 48px) color-mix(in srgb, var(--c) 55%, transparent);
  }
  [data-look='glow'] .mark {
    display: none;
  }

  /* Ink (print): grainy colour with the brand mark printed on it. Overlaps
     mix like inks laid on top of each other. */
  [data-look='ink'] .disc {
    background: url('/silo/grain.svg') center / 240px, var(--c);
  }
  [data-look='ink'] .silos li {
    mix-blend-mode: screen;
  }

  /* Lift a circle to the front when it, or its name, is pointed at. */
  .silos li:focus-within {
    z-index: 5;
    transform: scale(1.04);
  }
  @media (hover: hover) {
    .silos li:hover,
    .stage:has(.legend [data-pillar='recording']:hover) .silos [data-pillar='recording'],
    .stage:has(.legend [data-pillar='decamp']:hover) .silos [data-pillar='decamp'],
    .stage:has(.legend [data-pillar='creators']:hover) .silos [data-pillar='creators'],
    .stage:has(.legend [data-pillar='label']:hover) .silos [data-pillar='label'] {
      z-index: 5;
      transform: scale(1.04);
    }
    [data-look='glow'] .silos li:hover .disc {
      box-shadow:
        0 0 0 clamp(2px, 0.4cqw, 5px) var(--bg),
        0 0 clamp(28px, 5cqw, 80px) var(--c);
    }
    .stage:has(.silos [data-pillar='recording']:hover) .legend [data-pillar='recording'] button,
    .stage:has(.silos [data-pillar='decamp']:hover) .legend [data-pillar='decamp'] button,
    .stage:has(.silos [data-pillar='creators']:hover) .legend [data-pillar='creators'] button,
    .stage:has(.silos [data-pillar='label']:hover) .legend [data-pillar='label'] button,
    .legend button:hover {
      color: var(--fg);
    }
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    margin: clamp(20px, 3cqw, 40px) 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(12px, 1.1cqw, 16px);
    font-weight: 700;
    line-height: 1.2;
    font-variation-settings: 'wdth' 100;
  }
  .legend button {
    all: unset;
    cursor: pointer;
    color: var(--c);
    transition: color 0.2s;
  }
  .legend .no {
    margin-right: 0.5em;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .disc,
    .silos,
    .silos li {
      transition: none;
    }
  }
</style>
