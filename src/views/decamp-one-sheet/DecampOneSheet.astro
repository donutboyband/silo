---
// DeCamp one-sheet (v.1), rebuilt from DeCamp_OneSheet.pdf. Placeholder until
// DeCamp has a fuller page.
import { Picture } from 'astro:assets';
import Base from '@shared/layouts/Base.astro';
import { label, pillars, about, decamp } from '@shared/content/catalog';
import { socialMenus, accountFor } from '@shared/content/social-menus';
import { linkAttrs } from '@shared/lib/links';
import { routes } from '@shared/content/routes';
import mountainStudio from './images/mountain-studio.jpg';
import organWindow from './images/organ-window.jpg';

const issues = pillars.find((p) => p.key === 'decamp')!.items;
const site = issues.find((it) => it.url?.startsWith('http'))?.url;
const social = [
  ...socialMenus.map((m) => ({ name: m.title, url: accountFor(m, 'DeCamp')?.url })),
  { name: 'Substack', url: decamp.substack },
];
---

<Base
  title={`DeCamp · ${label.name}`}
  preloadFont={false}
  description="DeCamp is a traveling music collective: a new location every issue, two issues a year. Each issue is a four-song EP on vinyl and a print zine."
>
  <div class="page">
    <a class="back" href={routes.silo('decamp')}>← {label.name}</a>

    <article class="sheet">
      <header class="bar">
        <span class="motto">Beautiful music in beautiful spaces.</span>
        <h1 class="logo">DeCAMP</h1>
        <span class="meta">2026 <span>One-Sheet</span></span>
      </header>

      <section class="grid two intro">
        <div class="cell photo">
          {/* the first thing on the page: shown at most 380px wide */}
          <Picture
            src={mountainStudio}
            formats={['avif', 'webp']}
            widths={[380, 760]}
            sizes="(max-width: 760px) calc(100vw - 64px), 380px"
            loading="eager"
            fetchpriority="high"
            alt="A synth, a small keyboard and headphones on the floor of a glass room looking out over forested mountains."
          />
        </div>
        <div class="cell">
          <h2 class="lede">A new location every issue. Two issues a year.</h2>
          <hr />
          <p>
            DeCamp is a traveling music collective. Twice a year, a small group of musicians, an
            engineer, a producer, and a creative director packs up and goes to a place chosen for
            its culture, its music history, its energy. We rent a house, set up a mobile studio, and
            spend a week writing and recording a four-song EP.
          </p>
          <p>
            Each issue features the music-making process from start to finish alongside an in-depth
            look at the music culture of the city: the people, the places, and the history that
            define it. The result is two things released together: a limited-run vinyl record and a
            print zine.
          </p>
        </div>
      </section>

      <section class="cell experience">
        <h2 class="label">The Experience</h2>
        <p class="big">
          Each issue is built to be experienced as a pair. The music plays in the background. The
          zine moves you through the location, the features, and the week we spent there. One
          soundtracks the other.
        </p>
      </section>

      <section class="grid two">
        <div class="cell list-cell">
          <h2 class="label">The Music</h2>
          <ul class="dots">
            <li>A four-song EP written and recorded entirely on location</li>
            <li>Influenced by the sounds, history, and culture of the place</li>
            <li>Features a local artist</li>
          </ul>
          <div class="notes">
            <p>Pressed to vinyl in a limited run</p>
            <p>Digital download of the music</p>
          </div>
        </div>
        <div class="cell list-cell">
          <h2 class="label">The Publication</h2>
          <ul class="dots">
            <li>The process of making the music, start to finish</li>
            <li>A commercial studio &amp; a project studio</li>
            <li>A venue feature</li>
            <li>An artist, engineer, or producer</li>
            <li>A featured gear or instrument manufacturer</li>
          </ul>
          <div class="notes">
            <p>~20–30 pages, full color, perfect-bound (TBD)</p>
            <p>Digital edition of the zine</p>
          </div>
        </div>
      </section>

      <section class="cell genesis">
        <h2 class="label">The Genesis</h2>
        <p class="quote">
          The idea came from a simple place. A love of travel, making music, photography, magazines,
          and an ambition to bring those things together with the right group of people and make
          something tangible out of it.
        </p>
        <hr class="short" />
        <div class="cols">
          <div>
            <h3 class="sub">A recording studio fits in the back of a van.</h3>
            <p>
              It has never been easier to make music outside of a traditional studio. You can pack a
              legitimate mobile rig, set it up in a house on a lake or a cabin in the mountains, and
              walk out with high-quality recordings. There is something uniquely inspiring about
              creating in a different setting, and this is a publication meant to inspire that idea.
            </p>
          </div>
          <div>
            <h3 class="sub">Every city has a sound. We want to document that.</h3>
            <p>
              The music publications that exist today are mostly technical: gear reviews, recording
              tips, industry trade. Nothing covers the music culture of a place the way travel and
              food magazines cover their subjects. Countless cities carry a distinct music history
              that’s never been told. This is that publication.
            </p>
          </div>
        </div>
        <hr />
        <div class="cols aims">
          <p>Inspire the reader to go make more music in cool places.</p>
          <p>
            To shine a spotlight on musically rich towns and cities, and give their scenes the
            showcase they deserve.
          </p>
        </div>
      </section>

      <section class="cell mission">
        <p class="quote">
          The music exists to complement the publication, and the publication exists to spotlight
          the location, its culture, and the people making music there. The record is the soundtrack
          to the story.
        </p>
      </section>

      <section class="grid three">
        <div class="cell list-cell">
          <h2 class="label">The Collective</h2>
          <ul class="dots">
            <li>Musicians</li>
            <li>Engineer</li>
            <li>Producer</li>
            <li>Creative Director / Photographer</li>
          </ul>
          <p class="notes">
            A core founding team anchors every DeCamp, with rotating collaborators and at least one
            local musician from the destination joining each residency.
          </p>
        </div>
        <div class="cell list-cell">
          <h2 class="label">Residencies</h2>
          <ul class="dots">
            {issues.map((it) => <li>Issue {it.no} · {it.name} · ’{it.year?.slice(2)}</li>)}
          </ul>
          <hr />
          <h2 class="label">Releases</h2>
          <ul class="dots">
            <li>Vinyl + Print Zine</li>
            <li>Digital EP + Digital Zine</li>
          </ul>
        </div>
        <div class="cell photo flush">
          <Picture
            src={organWindow}
            formats={['avif', 'webp']}
            widths={[400, 788]}
            sizes="(max-width: 760px) 100vw, 360px"
            alt="A wooden organ beneath a tall window looking out over a hillside town."
          />
        </div>
      </section>

      <footer class="grid two info">
        <div class="cell">
          <h2 class="label small">▪ References &amp; Inspo</h2>
          <ul class="refs">
            {
              decamp.references.map((r) => (
                <li>
                  {r.url ? (
                    <a {...linkAttrs(r.url)}>{r.name}</a>
                  ) : (
                    <span>{r.name}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="cell contact">
          <div>
            <h2 class="label small">▪ Contact</h2>
            <p>{about.team[0].name}</p>
            <p><a href={`mailto:${label.contact}?subject=DeCamp`}>{label.contact}</a></p>
          </div>
          <div>
            <h2 class="label small">▪ Social</h2>
            {
              social.map((s) => (
                <p>
                  {s.url ? (
                    <a {...linkAttrs(s.url)}>{s.name}</a>
                  ) : (
                    s.name
                  )}
                </p>
              ))
            }
          </div>
          <div>
            <h2 class="label small">▪ Web</h2>
            <p>{site ? <a {...linkAttrs(site)}>{new URL(site).host}</a> : 'Soon'}</p>
          </div>
        </div>
      </footer>

      <div class="bar fine">
        <span>© DeCamp {label.year}</span>
        <span>One-Sheet · v.1</span>
      </div>
    </article>
  </div>
</Base>

<style>
  /* The one-sheet has its own paper look, separate from the black homepage. */
  :global(html),
  :global(body) {
    --bg: #e7e4dc;
    --fg: #1d1d1b;
    background: #e7e4dc;
    color-scheme: light;
  }

  .page {
    --paper: #f5f2ea;
    --ink: #1d1d1b;
    --soft: #55534d;
    --rule: #1d1d1b;
    --hair: #c9c5ba;
    --serif: 'Times New Roman', Times, Georgia, serif;
    --sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    padding: 24px 16px 64px;
    color: var(--ink);
    font-family: var(--sans);
    font-variation-settings: normal;
  }

  .back {
    display: block;
    max-width: 1040px;
    margin: 0 auto 12px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .back:hover {
    color: var(--ink);
  }

  .sheet {
    max-width: 1040px;
    margin: 0 auto;
    background: var(--paper);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 12px 40px rgb(0 0 0 / 0.06);
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  a:hover {
    color: var(--soft);
  }
  hr {
    border: 0;
    border-top: 1px solid var(--hair);
    margin: 20px 0;
  }

  /* top and bottom strips */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 16px 28px;
    border-bottom: 1px solid var(--rule);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .motto {
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    letter-spacing: 0;
    text-transform: none;
  }
  .logo {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.14em;
    text-transform: none;
  }
  .meta {
    justify-self: end;
  }
  .meta span {
    margin-left: 1.5em;
  }
  .fine {
    grid-template-columns: 1fr 1fr;
    border-bottom: 0;
    color: var(--soft);
    font-size: 10px;
    text-transform: none;
  }
  .fine span:last-child {
    justify-self: end;
  }

  /* bordered grid */
  .grid {
    display: grid;
    border-bottom: 1px solid var(--rule);
  }
  .two {
    grid-template-columns: 1fr 1fr;
  }
  .three {
    grid-template-columns: 1fr 1fr 1.1fr;
  }
  .grid > .cell + .cell {
    border-left: 1px solid var(--rule);
  }
  .cell {
    padding: 36px 28px;
  }
  section.cell {
    border-bottom: 1px solid var(--rule);
  }

  .label {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .label.small {
    font-size: 10px;
    margin-bottom: 14px;
  }

  p {
    font-size: 15px;
    line-height: 1.6;
  }
  p + p {
    margin-top: 1em;
  }

  .photo {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  .flush {
    padding: 0;
  }
  .flush :global(img) {
    max-width: none;
    height: 100%;
    object-fit: cover;
  }

  .intro .cell:last-child {
    align-self: center;
  }
  .lede {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.25;
  }

  .experience {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding-block: 56px;
  }
  .big {
    font-family: var(--serif);
    font-size: clamp(24px, 3.2vw, 36px);
    line-height: 1.3;
    max-width: 22em;
  }

  .list-cell {
    display: flex;
    flex-direction: column;
  }
  .dots li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.4;
  }
  .dots li + li {
    margin-top: 12px;
  }
  .dots li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.5em;
    width: 4px;
    height: 4px;
    background: var(--ink);
  }
  .notes {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--hair);
    font-style: italic;
    font-size: 13px;
    color: var(--soft);
  }
  .list-cell > .dots {
    margin-bottom: 32px;
  }
  .list-cell > hr + .label {
    margin-top: 0;
  }
  .notes p {
    font-size: 13px;
  }
  .notes p + p {
    margin-top: 0.5em;
  }

  .genesis .quote,
  .mission .quote {
    font-family: var(--serif);
    font-style: italic;
    text-align: center;
    max-width: 40em;
    margin-inline: auto;
  }
  .genesis .quote {
    font-size: 18px;
  }
  .short {
    max-width: 70%;
    margin: 32px auto;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .sub {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    margin-bottom: 16px;
  }
  .aims p {
    font-family: var(--serif);
    font-size: 17px;
    margin: 0;
  }

  .mission {
    padding-block: 56px;
  }
  .mission .quote {
    font-size: clamp(19px, 2.2vw, 24px);
    line-height: 1.5;
  }

  .info .cell {
    padding-block: 28px;
  }
  .refs {
    columns: 2;
    column-gap: 24px;
  }
  .refs li {
    font-size: 14px;
    line-height: 1.4;
    margin-bottom: 10px;
    break-inside: avoid;
  }
  .contact {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 20px;
  }
  .contact p {
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 760px) {
    .page {
      padding-top: 16px;
    }
    .bar {
      grid-template-columns: 1fr auto;
      padding: 14px 16px;
    }
    .motto {
      grid-column: 1 / -1;
      order: 3;
      font-size: 13px;
    }
    .logo {
      justify-self: start;
    }
    .two,
    .three,
    .cols,
    .experience {
      grid-template-columns: 1fr;
    }
    .grid > .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .cell {
      padding: 28px 16px;
    }
    .experience,
    .mission {
      padding-block: 36px;
    }
    .experience .label {
      margin-bottom: 0;
    }
    .cols {
      gap: 28px;
    }
    .flush :global(img) {
      height: auto;
    }
    .contact {
      grid-template-columns: 1fr 1fr;
    }
    .contact > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
