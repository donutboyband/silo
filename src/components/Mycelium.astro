---
// The Mycelium version's centrepiece: four nodes on a faint underground web.
// Clicking a node grows its roots out to its projects and
// brings it into focus: the view zooms to that colony and the silo's page
// opens beside it. Clicking the node again (or Back / Escape) zooms out.
//
// Two drawings are built: a wide one and a tall one for phones. CSS shows one.
// The lines are drawn as roots (see src/lib/mycelium.ts).
import { pillars } from '../data/catalog';
import { grow, type Network } from '../lib/mycelium';
import { usPaths } from '../lib/usmap';
import SiloDetail from './SiloDetail.astro';

// DeCamp's projects are places, so its roots grow onto a US map.
const us = usPaths(1.2);

// The way in: the four discs overlapping in a ring around the middle (as in
// the Silo version), then breaking out to their places. For node i: how far
// to shift it from its spot, and how much bigger it starts.
const RING = [
  [0, -1],
  [1, 0],
  [0, 1],
  [-1, 0],
];
const cluster = (net: Network, i: number, r: number) => {
  const n = net.nodes[i];
  return {
    dx: Math.round(net.w / 2 + RING[i][0] * r - n.x),
    dy: Math.round(net.h / 2 + RING[i][1] * r - n.y),
    k: Math.round((r / net.nodeR) * 100) / 100,
  };
};

const drawings: { id: string; net: Network; ring: number }[] = [
  {
    id: 'wide',
    net: grow(pillars, {
      w: 1000,
      h: 620,
      at: [
        { x: 250, y: 185 },
        { x: 655, y: 150 },
        { x: 280, y: 450 },
        { x: 735, y: 460 },
      ],
      reach: [150, 205],
      seed: 7,
      nodeR: 42,
      // top-right quarter; the DeCamp node sits out west, so its roots cross the country
      maps: { decamp: { x: 500, y: 12, s: 0.5 } },
    }),
    ring: 120,
  },
  {
    id: 'tall',
    net: grow(pillars, {
      w: 600,
      h: 1180,
      at: [
        { x: 200, y: 200 },
        { x: 295, y: 472 },
        { x: 200, y: 760 },
        { x: 400, y: 1010 },
      ],
      reach: [115, 150],
      seed: 11,
      nodeR: 52,
      charW: 13.2,
      labels: 'stack',
      maps: { decamp: { x: 20, y: 300, s: 0.574 } },
    }),
    ring: 130,
  },
];
---

<div class="myc intro mixing" data-myc>
  {
    drawings.map(({ id, net, ring }) => (
      <svg
        class:list={['net', id]}
        viewBox={`0 0 ${net.w} ${net.h}`}
        role="group"
        aria-label="Silo as a mycelium network: four nodes. Choose one to grow its threads."
      >
        <g class="web" aria-hidden="true">
          {net.web.map((p) => (
            <path d={p.d} stroke-width={p.w} stroke-opacity={p.o} pathLength="1" />
          ))}
        </g>

        {net.nodes.map((n, ni) => (
          <g class="colony" data-pillar={n.key} data-node={n.key}>
            {n.map && (
              <g class="usmap" transform={`translate(${n.map.x} ${n.map.y}) scale(${n.map.s})`} aria-hidden="true">
                <path class="us-nation" d={us.nation} pathLength="1" vector-effect="non-scaling-stroke" />
                <path class="us-borders" d={us.borders} vector-effect="non-scaling-stroke" />
              </g>
            )}
            <g class="hyphae" aria-hidden="true">
              {n.lines.map((h) => (
                <path d={h.d} stroke-width={h.w} pathLength="1" data-delay={h.delay} data-dur={h.dur} />
              ))}
            </g>

            <g class="tips">
              {n.tips.map((t) => (
                <g
                  class:list={['tip', { soon: t.soon }]}
                  transform={`translate(${t.x} ${t.y})`}
                  role="button"
                  tabindex="0"
                  aria-label={`${n.name}: ${t.name}${t.soon ? ', coming soon' : ''}`}
                  data-delay={t.delay}
                  data-name={t.name}
                  data-desc={t.desc}
                  data-url={t.url ?? ''}
                  data-soon={t.soon ? '1' : ''}
                >
                  <circle class="tip-hit" r="16" />
                  <circle class="tip-dot" r="5" />
                  <text class="tip-label" x={t.lx} y={t.ly} text-anchor={t.anchor}>
                    {t.name}
                  </text>
                </g>
              ))}
            </g>

            <g
              class="node"
              transform={`translate(${n.x} ${n.y})`}
              role="button"
              tabindex="0"
              aria-expanded="false"
              aria-label={`${n.name}: grow its threads`}
              data-name={n.name}
              data-desc={n.desc}
            >
              <circle class="node-hit" r={net.nodeR + 18} />
              <circle class="node-halo" r={net.nodeR + 10} />
              {/* the silo's disc: its colour, print grain, and its brand mark.
                  It starts in the opening cluster (data-dx/dy/k) and breaks out. */}
              <g
                class="node-body"
                data-dx={cluster(net, ni, ring).dx}
                data-dy={cluster(net, ni, ring).dy}
                data-k={cluster(net, ni, ring).k}
              >
              <circle class="node-core" r={net.nodeR} />
              <image
                class="node-grain"
                href="/silo/grain.svg"
                x={-net.nodeR}
                y={-net.nodeR}
                width={net.nodeR * 2}
                height={net.nodeR * 2}
                preserveAspectRatio="xMidYMid slice"
              />
              <image
                class="node-mark"
                href={`/silo/marks/${n.key}.svg`}
                x={-net.nodeR * 0.64}
                y={-net.nodeR * 0.64}
                width={net.nodeR * 1.28}
                height={net.nodeR * 1.28}
              />
              </g>
              <text class="node-label" y={n.labelDy} text-anchor="middle">
                {n.name}
              </text>
            </g>
          </g>
        ))}
      </svg>
    ))
  }


  {/* The front door: covers the drawing until the cluster is entered. */}
  <button class="enter" type="button" aria-label="Enter Silo">
    <span class="enter-label">Enter ↘</span>
  </button>

  {/* Each silo's page, opened beside its colony when it is in focus. */}
  {
    pillars.map((p, i) => (
      <aside class="focus" id={`focus-${p.key}`} data-pillar={p.key} hidden aria-labelledby={`focus-${p.key}-title`}>
        <button class="focus-back" type="button" data-focus-back>
          ← All silos
        </button>
        {/* Places (DeCamp) are already on the map beside it: just the summary. */}
        <SiloDetail
          p={p}
          i={i}
          idPrefix="focus"
          numbers={false}
          compact
          map={false}
          projects={!p.items.some((it) => it.at)}
        />
      </aside>
    ))
  }
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.querySelector<HTMLElement>('[data-myc]')!;
  const phone = matchMedia('(max-width: 640px)');
  let current = ''; // the silo in focus, if any

  // The faint web draws itself in, once you're in.
  const drawWeb = (lag = 0) => {
    if (reduce.matches) return;
    root.querySelectorAll<SVGPathElement>('.web path').forEach((p, i) => {
      p.animate(
        { strokeDashoffset: [1.5, 0] },
        { duration: 1800 + (i % 7) * 260, delay: lag + (i % 11) * 90, easing: 'cubic-bezier(0.3, 0.6, 0.3, 1)', fill: 'backwards' },
      );
    });
  };

  // ---------- the way in ----------
  // The four discs wait overlapped in a ring. Entering breaks them out to their
  // places, then names, rings and the web come in. Once per visit.
  const enterBtn = root.querySelector<HTMLButtonElement>('.enter')!;
  let seen = false;
  try {
    seen = sessionStorage.getItem('silo-entered') === '1';
  } catch {}
  const bodies = [...root.querySelectorAll<SVGGElement>('.node-body')];
  const clustered = (b: SVGGElement) => `translate(${b.dataset.dx}px, ${b.dataset.dy}px) scale(${b.dataset.k})`;
  const breakOut = bodies.map((b, i) =>
    b.animate([{ transform: clustered(b) }, { transform: 'none' }], {
      duration: 1150,
      delay: (i % 4) * 70,
      easing: 'cubic-bezier(0.76, 0, 0.24, 1)',
      fill: 'backwards',
    }),
  );

  function enter() {
    enterBtn.remove();
    root.classList.remove('intro');
    try {
      sessionStorage.setItem('silo-entered', '1');
    } catch {}
    breakOut.forEach((a) => a.play());
    Promise.all(breakOut.map((a) => a.finished)).then(() => root.classList.remove('mixing'));
    drawWeb(700);
  }

  if (seen || reduce.matches) {
    breakOut.forEach((a) => a.cancel());
    enterBtn.remove();
    root.classList.remove('intro', 'mixing');
    drawWeb();
  } else {
    breakOut.forEach((a) => a.pause()); // hold the cluster until entered
    root.classList.add('primed');
    enterBtn.addEventListener('click', enter);
  }

  // Grow or fold a node's colony. Both drawings (wide and tall) stay in step.
  function setColony(key: string, open: boolean) {
    root.querySelectorAll<SVGGElement>(`.colony[data-node="${key}"]`).forEach((col) => {
      col.classList.toggle('open', open);
      col.querySelector('.node')!.setAttribute('aria-expanded', String(open));
      if (reduce.matches) return;
      const visible = col.ownerSVGElement!.checkVisibility();
      if (!visible) return;
      // a map (DeCamp) outlines itself first, then the roots grow across it
      col.querySelectorAll<SVGPathElement>('.us-nation').forEach((p) =>
        p.animate({ strokeDashoffset: open ? [1.5, 0] : [0, 1.5] }, open ? { duration: 900, easing: 'ease-out' } : { duration: 350 }),
      );
      col.querySelectorAll<SVGGElement>('.usmap').forEach((m) =>
        m.animate({ opacity: open ? [0, 1] : [1, 0] }, open ? { duration: 500 } : { duration: 350 }),
      );
      col.querySelectorAll<SVGPathElement>('.hyphae path').forEach((p) => {
        const delay = Number(p.dataset.delay);
        const dur = Number(p.dataset.dur);
        p.animate(
          { strokeDashoffset: open ? [1.5, 0] : [0, 1.5] },
          open
            ? { duration: dur, delay, easing: 'cubic-bezier(0.25, 0.6, 0.3, 1)', fill: 'backwards' }
            : { duration: 380, easing: 'ease-in' },
        );
      });
      col.querySelectorAll<SVGGElement>('.tip').forEach((t) => {
        t.animate(
          { opacity: open ? [0, 1] : [1, 0] },
          open ? { duration: 300, delay: Number(t.dataset.delay), fill: 'backwards' } : { duration: 200 },
        );
      });
    });
  }

  // ---------- focus: zoom to one colony, its page beside it ----------
  const nets = [...root.querySelectorAll<SVGSVGElement>('.net')];
  const fullBox = new Map(nets.map((svg) => [svg, svg.getAttribute('viewBox')!.split(' ').map(Number)]));
  const shownNet = () => nets.find((n) => n.checkVisibility()) ?? nets[0];
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  // The viewBox is an attribute, so it's eased frame by frame (no inline styles).
  function tweenBox(svg: SVGSVGElement, to: number[], dur = 900) {
    const from = svg.getAttribute('viewBox')!.split(' ').map(Number);
    if (reduce.matches) return svg.setAttribute('viewBox', to.join(' '));
    const t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / dur);
      const e = easeInOut(t);
      svg.setAttribute('viewBox', from.map((v, i) => (v + (to[i] - v) * e).toFixed(2)).join(' '));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Fade everything but the chosen colony (or bring it all back).
  function fadeOthers(svg: SVGSVGElement, key: string | null) {
    svg.querySelectorAll<SVGGElement>('.web, .colony').forEach((g) => {
      const dim = key !== null && !(g.classList.contains('colony') && g.dataset.node === key);
      g.getAnimations().forEach((a) => a.cancel());
      if (dim) g.animate({ opacity: [1, 0.07] }, { duration: reduce.matches ? 0 : 600, fill: 'forwards' });
      g.classList.toggle('dimmed', dim);
    });
  }

  function focusOn(key: string, project?: string) {
    const svg = shownNet();
    const panel = root.querySelector<HTMLElement>(`#focus-${key}`)!;
    const switching = current !== key;
    if (current && switching) setColony(current, false);
    current = key;
    root.classList.add('focused');
    root.querySelectorAll<HTMLElement>('.focus').forEach((f) => (f.hidden = f !== panel));
    if (!root.querySelector(`.colony[data-node="${key}"].open`)) setColony(key, true);
    fadeOthers(svg, key);

    // Zoom so the colony fills the part of the drawing the page doesn't cover.
    const [, , W0, H0] = fullBox.get(svg)!;
    const ratio = W0 / H0;
    const box = svg.querySelector<SVGGElement>(`.colony[data-node="${key}"]`)!.getBBox();
    const r = svg.getBoundingClientRect();
    const share = phone.matches ? 1 : Math.min(1, Math.max(0.3, (panel.getBoundingClientRect().left - r.left) / r.width));
    const pad = 28;
    const vw = Math.max((box.width + 2 * pad) / share, (box.height + 2 * pad) * ratio, W0 * 0.42);
    const vh = vw / ratio;
    tweenBox(svg, [box.x + box.width / 2 - (vw * share) / 2, box.y + box.height / 2 - vh / 2, vw, vh]);

    // The page grows out of the node, like the silos on the Silo version.
    if (switching && !reduce.matches) {
      const node = svg.querySelector(`.colony[data-node="${key}"] .node`)!.getBoundingClientRect();
      const pr = panel.getBoundingClientRect();
      const x = node.left + node.width / 2 - pr.left;
      const y = node.top + node.height / 2 - pr.top;
      panel.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${Math.hypot(pr.width, pr.height) * 1.2}px at ${x}px ${y}px)`] },
        { duration: 800, delay: 150, easing: 'cubic-bezier(0.76, 0, 0.24, 1)', fill: 'backwards' },
      );
    }

    if (project) {
      const row = [...panel.querySelectorAll<HTMLElement>('.item')].find((it) =>
        it.querySelector('.item-name')?.textContent?.trim().startsWith(project),
      );
      if (row) {
        row.classList.remove('flash');
        void row.offsetWidth;
        row.classList.add('flash');
        row.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'nearest' });
      }
    }
    if (phone.matches) {
      setTimeout(() => panel.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth' }), reduce.matches ? 0 : 1000);
    }
  }

  function unfocus() {
    const key = current;
    if (!key) return;
    current = '';
    const svg = shownNet();
    const panel = root.querySelector<HTMLElement>(`#focus-${key}`)!;
    root.classList.remove('focused');
    setColony(key, false);
    fadeOthers(svg, null);
    tweenBox(svg, fullBox.get(svg)!);
    nets.filter((n) => n !== svg).forEach((n) => n.setAttribute('viewBox', fullBox.get(n)!.join(' ')));
    const hide = () => (panel.hidden = true);
    if (reduce.matches) hide();
    else panel.animate({ opacity: [1, 0] }, { duration: 250 }).finished.then(hide);
    svg.querySelector<SVGGElement>(`.colony[data-node="${key}"] .node`)?.focus({ preventScroll: true });
  }

  const activate = (el: Element, fn: () => void) => {
    el.addEventListener('click', fn);
    el.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'Enter' || k === ' ') {
        e.preventDefault();
        fn();
      }
    });
  };

  root.querySelectorAll<SVGGElement>('.node').forEach((node) => {
    const key = node.closest<SVGGElement>('.colony')!.dataset.node!;
    // in focus: click to back out; otherwise: grow it and bring it into focus
    activate(node, () => (current === key ? unfocus() : focusOn(key)));
  });

  root.querySelectorAll<SVGGElement>('.tip').forEach((tip) => {
    const col = tip.closest<SVGGElement>('.colony')!;
    activate(tip, () => focusOn(col.dataset.node!, tip.dataset.name!));
  });

  root.querySelectorAll<HTMLElement>('[data-focus-back]').forEach((b) => b.addEventListener('click', unfocus));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && current && !document.querySelector('dialog[open]')) unfocus();
  });
</script>

<style>
  .myc {
    position: relative;
    margin-top: clamp(16px, 3cqw, 40px);
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .net {
    display: block;
    width: 100%;
    max-width: 1200px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }
  /* the tall drawing is for phones */
  .tall {
    display: none;
  }
  @media (max-width: 640px) {
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
  }

  path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* a hidden line sits wholly in the gap, so its round ends can't show */
    stroke-dasharray: 1 2;
  }

  /* the underground: always there, faint */
  .web path {
    stroke: #8c8c8c;
    stroke-dashoffset: 0;
  }

  /* a colony's own threads, hidden until it opens */
  .hyphae path {
    stroke: var(--c);
    stroke-dashoffset: 1.5;
  }
  .open .hyphae path {
    stroke-dashoffset: 0;
  }

  /* DeCamp's map: hidden until its node opens */
  .usmap {
    visibility: hidden;
    opacity: 0;
  }
  .open .usmap {
    visibility: visible;
    opacity: 1;
  }
  .us-nation {
    fill: color-mix(in srgb, var(--c) 3%, transparent);
    stroke: var(--c);
    stroke-width: 1.2;
    stroke-opacity: 0.6;
    stroke-dashoffset: 0;
  }
  .us-borders {
    fill: none;
    stroke: var(--c);
    stroke-width: 0.6;
    stroke-opacity: 0.25;
    stroke-dasharray: 2 3;
  }

  /* project tips */
  .tip {
    cursor: pointer;
    outline: none;
    visibility: hidden;
    opacity: 0;
  }
  .open .tip {
    visibility: visible;
    opacity: 1;
  }
  .tip-hit {
    fill: transparent;
  }
  .tip-dot {
    fill: var(--c);
    stroke: var(--bg);
    stroke-width: 2;
    transition: r 0.15s;
  }
  .tip.soon .tip-dot {
    fill: var(--bg);
    stroke: var(--c);
    stroke-width: 1.6;
  }
  .tip-label {
    font-family: var(--f-mono);
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--c);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
  }
  .tip.soon .tip-label {
    opacity: 0.6;
  }
  .tip:hover .tip-dot,
  .tip:focus-visible .tip-dot {
    r: 8;
  }
  .tip:hover .tip-label,
  .tip:focus-visible .tip-label {
    fill: var(--fg);
    opacity: 1;
  }

  /* ---------- the way in ---------- */
  /* Until the script has stacked the discs into the cluster, show nothing. */
  .intro:not(.primed) .node-body {
    opacity: 0;
  }
  /* While clustered, and until they land: overlapping discs mix like inks. */
  .mixing .node-body {
    mix-blend-mode: screen;
  }
  .intro .web,
  .intro .node-label,
  .intro .node-halo {
    opacity: 0;
  }
  .node-label,
  .node-halo,
  .web {
    transition: opacity 0.6s ease 0.9s;
  }
  .enter {
    all: unset;
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    cursor: pointer;
  }
  .enter-label {
    margin-bottom: 1.5%;
    padding: 6px 12px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    font-variation-settings: 'wdth' 100;
    animation: nudge 1.6s ease-in-out infinite;
  }
  .enter:hover .enter-label,
  .enter:focus-visible .enter-label {
    background: var(--fg);
    color: var(--bg);
  }
  .enter:focus-visible {
    outline: none;
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* the four nodes */
  .node {
    cursor: pointer;
    outline: none;
  }
  .node-hit {
    fill: transparent;
  }
  .node-core {
    fill: var(--c);
  }
  .node-grain {
    clip-path: circle(50%);
    opacity: 0.9;
    pointer-events: none;
  }
  .node-mark {
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-box: fill-box;
    transform-origin: center;
  }
  .node:hover .node-mark,
  .node:focus-visible .node-mark {
    transform: scale(1.08);
  }
  .node-halo {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.2;
    stroke-opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 3.2s ease-in-out infinite;
  }
  .node:hover .node-halo,
  .node:focus-visible .node-halo,
  .open .node-halo {
    stroke-opacity: 1;
    stroke-width: 2;
  }
  .node:focus-visible .node-core {
    stroke: var(--fg);
    stroke-width: 3;
  }
  .node-label {
    font-family: var(--f-mono);
    font-size: 21px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--c);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
  }
  .node:hover .node-label,
  .node:focus-visible .node-label {
    fill: var(--fg);
  }
  @keyframes breathe {
    50% {
      transform: scale(1.18);
    }
  }

  /* bigger type on the tall (phone) drawing, which is shown smaller */
  .tall .tip-label {
    font-size: 21px;
  }
  .tall .node-label {
    font-size: 27px;
  }

  /* Fit the whole network on screen under the title and banner, however short
     the window. The title grows with the window's width (about 1.14 x its
     font size, which is (100vw - 60px) / 11), plus ~88px of banner and
     spacing. 1.613 is the drawing's width-to-height. */
  .wide {
    max-width: min(1200px, calc((100svh - 88px - (100vw - 60px) * 0.1036) * 1.613));
    transition: max-width 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }

  /* ---------- focus: a silo's page beside its colony ---------- */
  .dimmed {
    pointer-events: none;
  }
  .focus {
    position: absolute;
    top: 0;
    right: -16px;
    bottom: 0;
