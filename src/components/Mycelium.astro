---
// The Mycelium version's centrepiece: four nodes on a faint underground web.
// Clicking a node grows its roots out to its projects and
// opens that silo's page in the bottom half, under the drawing.
//
// Two drawings are built: a wide one and a tall one for phones. CSS shows one.
// The lines are drawn as roots (see src/lib/mycelium.ts).
import { pillars } from '../data/catalog';
import { grow, type Network } from '../lib/mycelium';
import { usPaths } from '../lib/usmap';
import SiloDetail from './SiloDetail.astro';

// DeCamp's projects are places, so its roots grow onto a US map.
const us = usPaths(1.2);

const drawings: { id: string; net: Network }[] = [
  {
    id: 'wide',
    net: grow(pillars, {
      w: 1000,
      h: 620,
      at: [
        { x: 250, y: 185 },
        { x: 655, y: 150 },
        { x: 280, y: 450 },
        { x: 735, y: 460 },
      ],
      reach: [150, 205],
      seed: 7,
      // top-right quarter; the DeCamp node sits out west, so its roots cross the country
      maps: { decamp: { x: 500, y: 12, s: 0.5 } },
    }),
  },
  {
    id: 'tall',
    net: grow(pillars, {
      w: 600,
      h: 1180,
      at: [
        { x: 200, y: 200 },
        { x: 295, y: 472 },
        { x: 200, y: 760 },
        { x: 400, y: 1010 },
      ],
      reach: [115, 150],
      seed: 11,
      charW: 13.2,
      labels: 'stack',
      maps: { decamp: { x: 20, y: 300, s: 0.574 } },
    }),
  },
];
---

<div class="myc" data-myc>
  {
    drawings.map(({ id, net }) => (
      <svg
        class:list={['net', id]}
        viewBox={`0 0 ${net.w} ${net.h}`}
        role="group"
        aria-label="Silo as a mycelium network: four nodes. Choose one to grow its threads."
      >
        <g class="web" aria-hidden="true">
          {net.web.map((p) => (
            <path d={p.d} stroke-width={p.w} stroke-opacity={p.o} pathLength="1" />
          ))}
        </g>

        {net.nodes.map((n) => (
          <g class="colony" data-pillar={n.key} data-node={n.key}>
            {n.map && (
              <g class="usmap" transform={`translate(${n.map.x} ${n.map.y}) scale(${n.map.s})`} aria-hidden="true">
                <path class="us-nation" d={us.nation} pathLength="1" vector-effect="non-scaling-stroke" />
                <path class="us-borders" d={us.borders} vector-effect="non-scaling-stroke" />
              </g>
            )}
            <g class="hyphae" aria-hidden="true">
              {n.lines.map((h) => (
                <path d={h.d} stroke-width={h.w} pathLength="1" data-delay={h.delay} data-dur={h.dur} />
              ))}
            </g>

            <g class="tips">
              {n.tips.map((t) => (
                <g
                  class:list={['tip', { soon: t.soon }]}
                  transform={`translate(${t.x} ${t.y})`}
                  role="button"
                  tabindex="0"
                  aria-label={`${n.name}: ${t.name}${t.soon ? ', coming soon' : ''}`}
                  data-delay={t.delay}
                  data-name={t.name}
                  data-desc={t.desc}
                  data-url={t.url ?? ''}
                  data-soon={t.soon ? '1' : ''}
                >
                  <circle class="tip-hit" r="16" />
                  <circle class="tip-dot" r="5" />
                  <text class="tip-label" x={t.lx} y={t.ly} text-anchor={t.anchor}>
                    {t.name}
                  </text>
                </g>
              ))}
            </g>

            <g
              class="node"
              transform={`translate(${n.x} ${n.y})`}
              role="button"
              tabindex="0"
              aria-expanded="false"
              aria-label={`${n.name}: grow its threads`}
              data-name={n.name}
              data-desc={n.desc}
            >
              <circle class="node-hit" r="34" />
              <circle class="node-halo" r="24" />
              <circle class="node-core" r="13" />
              <text class="node-label" y={n.labelBelow ? 52 : -36} text-anchor="middle">
                {n.name}
              </text>
            </g>
          </g>
        ))}
      </svg>
    ))
  }


  {/* Each silo's page, opened under the drawing when its node is clicked. */}
  {
    pillars.map((p, i) => (
      <section class="detail" id={`detail-${p.key}`} data-pillar={p.key} hidden aria-labelledby={`inline-${p.key}-title`}>
        <button class="detail-close" type="button" data-detail-close>
          Close ✕
        </button>
        <SiloDetail p={p} i={i} idPrefix="inline" numbers={false} />
      </section>
    ))
  }
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.querySelector<HTMLElement>('[data-myc]')!;
  const phone = matchMedia('(max-width: 640px)');
  let current = ''; // the silo whose page is open below, if any

  // The faint web draws itself in once, when the page loads.
  if (!reduce.matches) {
    root.querySelectorAll<SVGPathElement>('.web path').forEach((p, i) => {
      p.animate(
        { strokeDashoffset: [1, 0] },
        { duration: 1800 + (i % 7) * 260, delay: (i % 11) * 90, easing: 'cubic-bezier(0.3, 0.6, 0.3, 1)' },
      );
    });
  }

  // Grow or fold a node's colony. Both drawings (wide and tall) stay in step.
  function setColony(key: string, open: boolean) {
    root.querySelectorAll<SVGGElement>(`.colony[data-node="${key}"]`).forEach((col) => {
      col.classList.toggle('open', open);
      col.querySelector('.node')!.setAttribute('aria-expanded', String(open));
      if (reduce.matches) return;
      const visible = col.ownerSVGElement!.checkVisibility();
      if (!visible) return;
      // a map (DeCamp) outlines itself first, then the roots grow across it
      col.querySelectorAll<SVGPathElement>('.us-nation').forEach((p) =>
        p.animate({ strokeDashoffset: open ? [1, 0] : [0, 1] }, open ? { duration: 900, easing: 'ease-out' } : { duration: 350 }),
      );
      col.querySelectorAll<SVGGElement>('.usmap').forEach((m) =>
        m.animate({ opacity: open ? [0, 1] : [1, 0] }, open ? { duration: 500 } : { duration: 350 }),
      );
      col.querySelectorAll<SVGPathElement>('.hyphae path').forEach((p) => {
        const delay = Number(p.dataset.delay);
        const dur = Number(p.dataset.dur);
        p.animate(
          { strokeDashoffset: open ? [1, 0] : [0, 1] },
          open
            ? { duration: dur, delay, easing: 'cubic-bezier(0.25, 0.6, 0.3, 1)', fill: 'backwards' }
            : { duration: 380, easing: 'ease-in' },
        );
      });
      col.querySelectorAll<SVGGElement>('.tip').forEach((t) => {
        t.animate(
          { opacity: open ? [0, 1] : [1, 0] },
          open ? { duration: 300, delay: Number(t.dataset.delay), fill: 'backwards' } : { duration: 200 },
        );
      });
    });
  }

  // Open a silo's page under the drawing. A project name, if given, is
  // highlighted there (on DeCamp's map, its city is picked).
  function showDetail(key: string, project?: string) {
    const sec = root.querySelector<HTMLElement>(`#detail-${key}`)!;
    const switching = current !== key;
    root.querySelectorAll<HTMLElement>('.detail').forEach((d) => (d.hidden = d !== sec));
    root.classList.add('has-detail');
    current = key;
    if (switching && !reduce.matches) {
      sec.animate(
        { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0 0)'] },
        { duration: 650, easing: 'cubic-bezier(0.76, 0, 0.24, 1)' },
      );
    }
    if (project) {
      const dot = [...sec.querySelectorAll<SVGGElement>('.dot')].find((d) => d.getAttribute('aria-label')?.includes(project));
      if (dot) dot.dispatchEvent(new MouseEvent('click', { bubbles: true }));
      const row = [...sec.querySelectorAll<HTMLElement>('.item')].find((r) =>
        r.querySelector('.item-name')?.textContent?.trim().startsWith(project),
      );
      const target = dot ?? row;
      if (row) {
        row.classList.remove('flash');
        void row.offsetWidth;
        row.classList.add('flash');
      }
      target?.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'center' });
    } else if (phone.matches) {
      // on a phone the page is below the drawing: go to it once the roots have grown
      setTimeout(() => sec.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth' }), reduce.matches ? 0 : 1100);
    }
  }

  function hideDetail() {
    root.querySelectorAll<HTMLElement>('.detail').forEach((d) => (d.hidden = true));
    root.classList.remove('has-detail');
    current = '';
  }

  const activate = (el: Element, fn: () => void) => {
    el.addEventListener('click', fn);
    el.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'Enter' || k === ' ') {
        e.preventDefault();
        fn();
      }
    });
  };

  root.querySelectorAll<SVGGElement>('.node').forEach((node) => {
    const key = node.closest<SVGGElement>('.colony')!.dataset.node!;
    activate(node, () => {
      const open = node.getAttribute('aria-expanded') !== 'true';
      setColony(key, open);
      if (open) showDetail(key);
      else if (current === key) hideDetail();
    });
  });

  root.querySelectorAll<SVGGElement>('.tip').forEach((tip) => {
    const col = tip.closest<SVGGElement>('.colony')!;
    activate(tip, () => showDetail(col.dataset.node!, tip.dataset.name!));
  });

  // Close folds that silo's roots too.
  root.querySelectorAll<HTMLElement>('[data-detail-close]').forEach((b) =>
    b.addEventListener('click', () => {
      const key = current;
      hideDetail();
      if (key) setColony(key, false);
      root.querySelector<SVGGElement>(`.net:not([hidden]) .colony[data-node="${key}"] .node`)?.focus();
    }),
  );
</script>

<style>
  .myc {
    position: relative;
    margin-top: clamp(16px, 3cqw, 40px);
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .net {
    display: block;
    width: 100%;
    max-width: 1200px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }
  /* the tall drawing is for phones */
  .tall {
    display: none;
  }
  @media (max-width: 640px) {
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
  }

  path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
  }

  /* the underground: always there, faint */
  .web path {
    stroke: #8c8c8c;
    stroke-dashoffset: 0;
  }

  /* a colony's own threads, hidden until it opens */
  .hyphae path {
    stroke: var(--c);
    stroke-dashoffset: 1;
  }
  .open .hyphae path {
    stroke-dashoffset: 0;
  }

  /* DeCamp's map: hidden until its node opens */
  .usmap {
    visibility: hidden;
    opacity: 0;
  }
  .open .usmap {
    visibility: visible;
    opacity: 1;
  }
  .us-nation {
    fill: color-mix(in srgb, var(--c) 3%, transparent);
    stroke: var(--c);
    stroke-width: 1.2;
    stroke-opacity: 0.6;
    stroke-dashoffset: 0;
  }
  .us-borders {
    fill: none;
    stroke: var(--c);
    stroke-width: 0.6;
    stroke-opacity: 0.25;
    stroke-dasharray: 2 3;
  }

  /* project tips */
  .tip {
    cursor: pointer;
    outline: none;
    visibility: hidden;
    opacity: 0;
  }
  .open .tip {
    visibility: visible;
    opacity: 1;
  }
  .tip-hit {
    fill: transparent;
  }
  .tip-dot {
    fill: var(--c);
    stroke: var(--bg);
    stroke-width: 2;
    transition: r 0.15s;
  }
  .tip.soon .tip-dot {
    fill: var(--bg);
    stroke: var(--c);
    stroke-width: 1.6;
  }
  .tip-label {
    font-family: var(--f-mono);
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--c);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
  }
  .tip.soon .tip-label {
    opacity: 0.6;
  }
  .tip:hover .tip-dot,
  .tip:focus-visible .tip-dot {
    r: 8;
  }
  .tip:hover .tip-label,
  .tip:focus-visible .tip-label {
    fill: var(--fg);
    opacity: 1;
  }

  /* the four nodes */
  .node {
    cursor: pointer;
    outline: none;
  }
  .node-hit {
    fill: transparent;
  }
  .node-core {
    fill: var(--c);
  }
  .node-halo {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.2;
    stroke-opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 3.2s ease-in-out infinite;
  }
  .node:hover .node-halo,
  .node:focus-visible .node-halo,
  .open .node-halo {
    stroke-opacity: 1;
    stroke-width: 2;
  }
  .node:focus-visible .node-core {
    stroke: var(--fg);
    stroke-width: 3;
  }
  .node-label {
    font-family: var(--f-mono);
    font-size: 21px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--c);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
  }
  .node:hover .node-label,
  .node:focus-visible .node-label {
    fill: var(--fg);
  }
  @keyframes breathe {
    50% {
      transform: scale(1.18);
    }
  }

  /* bigger type on the tall (phone) drawing, which is shown smaller */
  .tall .tip-label {
    font-size: 21px;
  }
  .tall .node-label {
    font-size: 27px;
  }

  /* With a silo open below, the drawing shrinks so both fit on screen. */
  .wide {
    transition: max-width 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .myc.has-detail .wide {
    max-width: min(100%, 84vh);
  }

  /* ---------- a silo's page, under the drawing ---------- */
  .detail {
    position: relative;
    margin: clamp(16px, 2.5vw, 32px) -16px -48px;
    padding: 12px 16px 64px;
    min-height: 60vh;
    /* when scrolled to, stop below the fixed top bar */
    scroll-margin-top: 56px;
    background: var(--c);
    color: var(--bg);
    /* undo the big title type this sits inside */
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }
  .detail[hidden] {
    display: none;
  }
  .detail-close {
    all: unset;
    float: right;
    margin-left: 16px;
    cursor: pointer;
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 800;
    text-transform: uppercase;
  }
  .detail-close:hover {
    color: var(--fg);
  }
  .detail-close:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: 2px;
  }
  /* a project picked on the drawing flashes in the list */
  .detail :global(.item.flash) {
    animation: flash 1.6s ease-out;
  }
  @keyframes flash {
    0%,
    30% {
      background: rgb(0 0 0 / 0.14);
    }
    100% {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node-halo {
      animation: none;
    }
  }
</style>
