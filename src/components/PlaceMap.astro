---
// A map of the US with a dot for every place that has coordinates. Clicking a
// dot shows that place's card. The map is drawn here at build time from
// us-atlas, so the page ships plain SVG and no map library.
import { geoAlbersUsa, geoPath } from 'd3-geo';
import { feature, mesh } from 'topojson-client';
import { presimplify, simplify } from 'topojson-simplify';
import type { Topology, GeometryCollection } from 'topojson-specification';
import usRaw from 'us-atlas/states-albers-10m.json';
import type { Item } from '../data/catalog';

interface Props {
  id: string;
  items: Item[];
}
const { id, items } = Astro.props;

// states-albers-10m is already projected into a 975x610 box with this
// projection, so city points use the same one to land in the right place.
const W = 975;
const H = 610;
const project = geoAlbersUsa().scale(1300).translate([487.5, 305]);

// Thin the outline a little: plenty of detail at this size, much less markup.
const us = simplify(presimplify(usRaw as unknown as Topology), 0.6) as Topology<{
  states: GeometryCollection;
  nation: GeometryCollection;
}>;
const draw = geoPath().digits(1);
const nation = draw(feature(us, us.objects.nation));
const borders = draw(mesh(us, us.objects.states, (a, b) => a !== b));

const places = items
  .filter((it) => it.at)
  .map((it, i) => {
    const [x, y] = project([it.at![1], it.at![0]]) ?? [0, 0];
    const side = it.labelSide ?? 'right';
    const lx = side === 'left' ? -22 : side === 'right' ? 22 : 0;
    const ly = side === 'above' ? -26 : side === 'below' ? 40 : 8;
    const anchor = side === 'left' ? 'end' : side === 'right' ? 'start' : 'middle';
    return { ...it, i, x: Math.round(x), y: Math.round(y), lx, ly, anchor };
  });
const first = places.findIndex((p) => !p.soon);
const selected = first === -1 ? 0 : first;
const isExternal = (url?: string) => !!url?.startsWith('http');
---

<div class="place-map" data-place-map>
  <svg class="map" viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of DeCamp cities">
    <path class="nation" d={nation} />
    <path class="borders" d={borders} />

    {
      places.map((p) => (
        <g
          class:list={['dot', { soon: p.soon }]}
          transform={`translate(${p.x} ${p.y})`}
          role="button"
          tabindex="0"
          aria-pressed={String(p.i === selected)}
          aria-controls={`${id}-card-${p.i}`}
          aria-label={`Issue ${p.no}, ${p.name}${p.soon ? ', coming soon' : ''}`}
        >
          <circle class="hit" r="26" />
          <circle class="pulse" r="11" />
          <circle class="ring" r="11" />
          <circle class="core" r="5.5" />
          <text class="label" x={p.lx} y={p.ly} text-anchor={p.anchor}>
            <tspan class="label-no">#{p.no} </tspan>
            {p.name}
          </text>
        </g>
      ))
    }
  </svg>

  <div class="cards">
    {
      places.map((p) => (
        <article class="card" id={`${id}-card-${p.i}`} hidden={p.i !== selected} aria-live="polite">
          <p class="card-no">
            Issue {p.no}
            {p.soon && <span class="card-tag">Soon</span>}
          </p>
          <h3 class="card-name">{p.name}</h3>
          <p class="card-desc">{p.desc}</p>
          {p.url && !p.soon && (
            <a
              class="card-link"
              href={p.url}
              target={isExternal(p.url) ? '_blank' : undefined}
              rel={isExternal(p.url) ? 'noopener' : undefined}
            >
              More ↗
            </a>
          )}
        </article>
      ))
    }
    <p class="hint">Tap a dot to see the issue.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-place-map]').forEach((map) => {
    const dots = [...map.querySelectorAll<SVGGElement>('.dot')];
    const pick = (dot: SVGGElement) =>
      dots.forEach((d) => {
        const on = d === dot;
        d.setAttribute('aria-pressed', String(on));
        document.getElementById(d.getAttribute('aria-controls')!)!.hidden = !on;
      });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => pick(dot));
      dot.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pick(dot);
        }
      });
    });
  });
</script>

<style>
  .place-map {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(240px, 1fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    margin-top: clamp(28px, 4vw, 56px);
    padding-top: clamp(20px, 3vw, 40px);
    border-top: 2px solid var(--bg);
  }

  .map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .nation {
    fill: rgb(0 0 0 / 0.06);
    stroke: var(--bg);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .borders {
    fill: none;
    stroke: var(--bg);
    stroke-width: 0.6;
    stroke-opacity: 0.35;
    stroke-dasharray: 2 3;
  }

  /* dots: solid for an issue that's happening, a hollow ring for one to come */
  .dot {
    cursor: pointer;
    outline: none;
  }
  .hit {
    fill: transparent;
  }
  .ring {
    fill: var(--c);
    stroke: var(--bg);
    stroke-width: 2.5;
    transition: r 0.2s;
  }
  .core {
    fill: var(--bg);
    transition: r 0.2s;
  }
  .soon .core {
    fill: transparent;
  }
  .soon .label {
    opacity: 0.55;
  }
  .label {
    font-family: var(--f-mono);
    font-size: 23px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--bg);
    paint-order: stroke;
    stroke: var(--c);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .label-no {
    font-size: 15px;
    font-weight: 600;
  }

  .pulse {
    fill: none;
    stroke: var(--bg);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .dot[aria-pressed='true'] .pulse {
    animation: pulse 1.8s ease-out infinite;
  }
  .dot[aria-pressed='true'] .ring,
  .dot:hover .ring,
  .dot:focus-visible .ring {
    r: 14;
  }
  .dot[aria-pressed='true'] .core {
    r: 7;
    fill: var(--bg);
  }
  .dot[aria-pressed='true'] .label {
    opacity: 1;
  }
  .dot:focus-visible .ring {
    stroke-width: 4;
  }
  @keyframes pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  /* the card for the chosen place */
  .cards {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .card[hidden] {
    display: none;
  }
  .card-no {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
    opacity: 0.7;
  }
  .card-tag {
    margin-left: 0.8em;
    padding: 1px 6px;
    border: 1.5px solid currentColor;
  }
  .card-name {
    margin: 0 0 14px;
    font-size: clamp(30px, 4vw, 60px);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .card-desc {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(14px, 1.3vw, 18px);
    font-weight: 500;
    line-height: 1.45;
    font-variation-settings: 'wdth' 100;
  }
  .card-link {
    display: inline-block;
    margin-top: 16px;
    font-weight: 800;
    text-transform: uppercase;
    border-bottom: 2px solid currentColor;
  }
  .card-link:hover {
    color: var(--fg);
  }
  .hint {
    margin: 18px 0 0;
    font-size: 12px;
    font-weight: 500;
    font-variation-settings: 'wdth' 100;
    opacity: 0.6;
  }

  @media (max-width: 720px) {
    .place-map {
      grid-template-columns: 1fr;
    }
    .label {
      font-size: 30px;
    }
    .label-no {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot[aria-pressed='true'] .pulse {
      animation: none;
    }
  }
</style>
