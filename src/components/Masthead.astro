---
// The SILO title (which opens About) and the scrolling banner under it.
import { banner } from '../data/catalog';

// Enough copies that one group is wider than any screen; the track holds two
// groups and slides left by exactly one, so the loop has no seam.
const copies = Array.from({ length: 8 });
---

    {/* The title is the way into About. */}
    <h1>
      <button
        class="row about-btn"
        type="button"
        data-open="silo-about"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Silo: about us"
      >
        <span class="tag"><i>About</i>↗</span>
        <span class="name">Silo</span>
      </button>
    </h1>

    <a class="ticker" href={banner.url}>
      <span class="sr">{banner.text}</span>
      <span class="track" aria-hidden="true">
        {
          [0, 1].map(() => (
            <span class="group">
              {copies.map(() => (
                <span class="msg">
                  {banner.text}
                  <span class="sep">///</span>
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </a>

<style>
  h1 {
    margin: 0;
    padding: 0;
    font: inherit;
    color: var(--fg);
  }
  /* the SILO title doubles as the About button */
  .about-btn {
    all: unset;
    display: flex;
    cursor: pointer;
  }
  .about-btn .tag {
    width: auto;
    min-width: 1.7rem;
    transition: color 0.2s;
  }
  .about-btn .name {
    transition: color 0.2s;
  }
  .about-btn:hover .tag,
  .about-btn:focus-visible .tag {
    color: var(--fg);
  }
  .about-btn:hover .name {
    color: #d9d9d9;
  }
  .about-btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  /* ---------- scrolling banner ---------- */
  .ticker {
    display: block;
    margin: 0.2em -16px 0;
    overflow: hidden;
    background: var(--fg);
    color: var(--bg);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    font-variation-settings: 'wdth' 100;
  }
  .track {
    display: flex;
    width: max-content;
    animation: ticker 70s linear infinite;
  }
  .ticker:hover .track {
    animation-play-state: paused;
  }
  .group {
    display: flex;
  }
  .msg {
    padding: 7px 0;
    white-space: nowrap;
  }
  .sep {
    padding: 0 1.4em;
    color: var(--accent);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
