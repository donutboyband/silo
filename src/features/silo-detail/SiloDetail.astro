---
// One silo's page, shown beside its colony on the homepage drawing: its name,
// description, sign-up box and follow icons, then its projects. One narrow
// column, scaled down by --fit until it fits on screen.
import type { Pillar } from '@shared/content/catalog';
import { socialMenus, accountFor } from '@shared/content/social-menus';
import SocialIcon from '@shared/ui/SocialIcon.astro';
import { linkAttrs } from '@shared/lib/links';
import SignupRow from '@shared/ui/signup/SignupRow.astro';

interface Props {
  p: Pillar;
  /** false: leave the projects out entirely (just the summary) */
  projects?: boolean;
}
const { p, projects = true } = Astro.props;
---

<div class="silo-detail">
<h2 class="panel-title" id={`focus-${p.key}-title`}>{p.name}</h2>

<div class="panel-intro">
  <p class="panel-desc">{p.desc}</p>

  {/* Sign up and follow, just for this silo. Placeholder: sends nothing yet. */}
  <div class="optin">
    <form class="optin-form" novalidate>
      <p class="optin-title">Get {p.name} updates</p>
      <input type="hidden" name="list" value={p.key} />
      <SignupRow id={`focus-optin-${p.key}`} tone="on-colour" />
    </form>

    <div class="follow">
      <span class="follow-label">Follow</span>
      {socialMenus.map((m) => {
        const acct = accountFor(m, p.socialName);
        const name = `${p.socialName} on ${m.title}`;
        return acct?.url ? (
          <a class="follow-icon" {...linkAttrs(acct.url)} aria-label={name}>
            <SocialIcon kind={m.id} />
          </a>
        ) : (
          <span class="follow-icon soon-icon" role="img" aria-label={`${name}, coming soon`} title="Coming soon">
            <SocialIcon kind={m.id} />
          </span>
        );
      })}
    </div>
  </div>
</div>

{projects && (
<ul class="items">
  {p.items.map((it) => {
    const Tag = it.soon || !it.url ? 'span' : 'a';
    return (
      <li>
        <Tag class:list={['item', { soon: it.soon }]} {...(Tag === 'a' ? linkAttrs(it.url) : {})}>
          <span class="item-name">
            {it.name}
            {Tag === 'a' && <span class="arr">↗</span>}
          </span>
          <span class="item-desc">{it.soon ? `Soon. ${it.desc}` : it.desc}</span>
        </Tag>
      </li>
    );
  })}
</ul>
)}

{p.url && (
  <a class="more" href={p.url}>
    {p.urlLabel ?? 'More'} ↗
  </a>
)}

</div>
<script>
  import { wireSignup } from '@shared/ui/signup/signup';
  document.querySelectorAll<HTMLFormElement>('.optin-form').forEach((form) => wireSignup(form));
</script>

<style>
  /* Sizes scale by --fit (1 = full size), which the page lowers step by step
     until the whole panel fits on screen without scrolling. */
  .silo-detail {
    --f: var(--fit, 1);
  }
  h2,
  p,
  ul {
    margin: 0;
    padding: 0;
    font: inherit;
    list-style: none;
  }

  .panel-title {
    font-size: calc(clamp(30px, 3.6vw, 60px) * var(--f));
  }
  .panel-intro {
    display: grid;
    gap: calc(14px * var(--f));
    margin-top: calc(12px * var(--f));
  }
  .panel-desc {
    font-size: calc(clamp(15px, 1.25vw, 19px) * var(--f));
    font-weight: 600;
    line-height: 1.25;
    font-variation-settings: 'wdth' 100;
  }

  .optin {
    padding: calc(12px * var(--f));
    border: 2px solid var(--bg);
    font-variation-settings: 'wdth' 100;
  }
  .optin-title {
    margin: 0 0 calc(10px * var(--f));
    font-size: calc(14px * var(--f));
    font-weight: 800;
    text-transform: uppercase;
  }
  .follow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: calc(10px * var(--f));
    padding-top: calc(8px * var(--f));
    border-top: 1px solid rgb(0 0 0 / 0.25);
  }
  .follow-label {
    margin-right: auto;
    font-size: calc(14px * var(--f));
    font-weight: 800;
    text-transform: uppercase;
  }
  .follow-icon {
    display: inline-flex;
  }
  .follow-icon :global(svg) {
    width: calc(24px * var(--f));
    height: calc(24px * var(--f));
  }
  a.follow-icon:hover {
    color: var(--fg);
  }
  .soon-icon {
    opacity: 0.4;
    cursor: default;
  }

  .items {
    margin-top: calc(16px * var(--f));
    border-top: 2px solid var(--bg);
  }
  .items li {
    border-bottom: 2px solid var(--bg);
  }
  .item {
    display: grid;
    gap: calc(4px * var(--f));
    padding: calc(9px * var(--f)) 0 calc(10px * var(--f));
  }
  .item-name {
    min-width: 0;
    font-size: calc(clamp(20px, 2vw, 30px) * var(--f));
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .arr {
    font-size: 0.6em;
    margin-left: 0.15em;
  }
  .item-desc {
    font-size: calc(13px * var(--f));
    font-weight: 500;
    line-height: 1.4;
    font-variation-settings: 'wdth' 100;
  }
  a.item:hover .item-name,
  a.item:focus-visible .item-name {
    color: var(--fg);
  }
  .soon {
    opacity: 0.45;
  }

  .more {
    display: inline-block;
    margin-top: calc(14px * var(--f));
    font-size: calc(16px * var(--f));
    font-weight: 800;
    text-transform: uppercase;
    border-bottom: 2px solid currentColor;
  }
  .more:hover {
    color: var(--fg);
  }
</style>
