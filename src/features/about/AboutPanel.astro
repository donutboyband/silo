---
// The full-screen About panel. It opens out of the button that names it with
// data-open="<panel id>" (the SILO title), growing from that button as a circle.
// The silos themselves open inside the mycelium drawing (Mycelium.astro).
import { pillars, label, about } from '@shared/content/catalog';
import { pad2 } from '@shared/lib/links';
---

  {/* ---------- About: opens from the SILO title ---------- */}
  <dialog class="panel" id="silo-about" data-pillar="about" aria-labelledby="silo-about-title">
    <div class="inner">
      <button class="close" type="button" data-close>
        Close ✕
      </button>

      <h2 class="panel-title row" id="silo-about-title">
        <span class="tag"><i>est</i>{label.year}</span>
        <span class="name">About {label.name}</span>
      </h2>

      <div class="about-body">
        {about.summary.map((t) => <p class="about-lede">{t}</p>)}
      </div>

      <section class="about-sec">
        <h3 class="about-h">The four silos</h3>
        <ol class="about-silos">
          {
            pillars.map((p, i) => (
              <li data-pillar={p.key}>
                <span class="swatch" aria-hidden="true" />
                <span class="about-silo-no">#{pad2(i + 1)}</span>
                <span class="about-silo-name">{p.name}</span>
                <span class="about-silo-desc">{p.desc}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="about-sec">
        <h3 class="about-h">Team</h3>
        <ul class="team">
          {
            about.team.map((m) => (
              <li>
                <p class="team-name">{m.name}</p>
                <p class="team-role">{m.role}</p>
                <p class="team-bio">{m.bio}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </dialog>

<script>
  // A panel opens as a circle that grows out of the button you clicked until it
  // fills the screen, then closes back into it.
  import { EASE as ease, circle, reduceMotion as reduce } from '@shared/lib/reveal';

  // The button a panel opens from: the SILO title for About.
  const circleBtn = (id: string) => document.querySelector<HTMLElement>(`[data-open="${id}"]`)!;

  function circles(btn: HTMLElement) {
    // Grow from the middle of the title.
    const r = (btn.querySelector('.name') ?? btn).getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const far = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    return {
      small: circle(Math.min(r.width, r.height) / 2, x, y),
      big: circle(far, x, y),
    };
  }

  function open(btn: HTMLElement) {
    const panel = document.getElementById(btn.dataset.open!) as HTMLDialogElement;
    panel.showModal();
    panel.scrollTop = 0;
    document.documentElement.classList.add('locked');
    btn.setAttribute('aria-expanded', 'true');
    if (reduce.matches) return;

    const c = circles(btn);
    panel.animate({ clipPath: [c.small, c.big] }, { duration: 750, easing: ease });
    panel.querySelector('.inner')!.animate(
      { opacity: [0, 1], transform: ['translateY(28px)', 'none'] },
      { duration: 450, delay: 380, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fill: 'backwards' },
    );
  }

  async function close(panel: HTMLDialogElement) {
    if (panel.dataset.closing) return;
    panel.dataset.closing = '1';
    const btn = circleBtn(panel.id);

    if (!reduce.matches) {
      const c = circles(btn);
      panel.querySelector('.inner')!.animate({ opacity: [1, 0] }, { duration: 160, fill: 'forwards' });
      await panel.animate({ clipPath: [c.big, c.small] }, { duration: 600, easing: ease, fill: 'forwards' })
        .finished;
    }

    panel.close();
    panel.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    delete panel.dataset.closing;
    document.documentElement.classList.remove('locked');
    btn.setAttribute('aria-expanded', 'false');
    btn.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => open(btn));
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.panel').forEach((panel) => {
    // Escape key
    panel.addEventListener('cancel', (e) => {
      e.preventDefault();
      close(panel);
    });
    panel.querySelector('[data-close]')!.addEventListener('click', () => close(panel));
  });
</script>

<style>
  h2,
  p,
  ul {
    margin: 0;
    padding: 0;
    font: inherit;
    list-style: none;
  }

  /* ---------- About panel (white) ---------- */
  .about-body {
    margin-top: clamp(16px, 2.5vw, 36px);
    max-width: 40ch;
  }
  .about-lede {
    font-size: clamp(18px, 2.2vw, 32px);
    font-weight: 600;
    line-height: 1.3;
    font-variation-settings: 'wdth' 100;
  }
  .about-lede + .about-lede {
    margin-top: 0.8em;
  }
  .about-sec {
    margin-top: clamp(36px, 5vw, 72px);
    padding-top: 14px;
    border-top: 2px solid var(--bg);
  }
  .about-h {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
  }
  .about-silos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-silos li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c);
    border: 2px solid var(--bg);
    margin-bottom: 4px;
  }
  .about-silo-no {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.6;
    font-variation-settings: 'wdth' 100;
  }
  .about-silo-name {
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .about-silo-desc {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    font-variation-settings: 'wdth' 100;
  }
  .team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .team-name {
    font-size: clamp(28px, 3.4vw, 52px);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .team-role {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
    opacity: 0.6;
  }
  .team-bio {
    margin-top: 10px;
    max-width: 42ch;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
    font-variation-settings: 'wdth' 100;
  }
  @media (max-width: 900px) {
    .about-silos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .about-silos,
    .team {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- the panel shell ---------- */
  .panel {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--c);
    color: var(--bg);
    font-family: var(--f-mono);
    font-variation-settings: 'wdth' 75;
  }
  .panel::backdrop {
    background: transparent;
  }
  .inner {
    min-height: 100%;
    padding: 12px 16px 64px;
  }
  .panel .tag {
    color: inherit;
    opacity: 0.6;
  }

  .close {
    all: unset;
    position: sticky;
    top: 0;
    float: right;
    margin-left: 16px;
    cursor: pointer;
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 800;
    text-transform: uppercase;
    background: var(--c);
    padding: 0 0 4px 8px;
  }
  .close:hover {
    color: var(--fg);
  }
  .close:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: 2px;
  }

</style>
