---
// The homepage centrepiece: four nodes on a faint underground web. Clicking a
// node grows its roots out to its projects and brings it into focus beside
// its page, and the address bar follows (/recording/ and so on). Behaviour:
// mycelium.client.ts.
//
// Two drawings are built, a wide one and a tall one for phones, and CSS shows
// one (layouts: lib/layouts.ts; the roots: lib/grow.ts).
//
// The view passes one <FocusPanel> per silo in the default slot.
import { createHash } from 'node:crypto';
import { label, pillars, type PillarKey } from '@shared/content/catalog';
import { routes, titleFor } from '@shared/content/routes';
import { drawings } from './lib/layouts';
import { usPaths } from './lib/usmap';
import { siloArt } from './lib/silo-art';
import { sandboxArt } from './lib/sandbox-art';
import MyceliumNet from './MyceliumNet.astro';

interface Props {
  /** the silo in focus on load: the page is that silo's URL */
  focus?: PillarKey;
}
const { focus } = Astro.props;

// DeCamp's projects are places, so its roots grow onto a US map.
const us = usPaths();
// Lo-fi drawings behind other nodes (placed in lib/layouts.ts by id):
// Silo Recording stands on a farm silo, Sandbox sits in a sandbox.
const arts = [
  { id: 'silo-art', art: siloArt() },
  { id: 'sandbox-art', art: sandboxArt(pillars.find((p) => p.key === 'label')!.items) },
];

// Before first paint: a first visit this session gets the way in (the discs
// start overlapped). Returning visitors, a silo's own URL, reduced motion and
// no JS see the network as it is. Inline so it runs before the drawing shows; Astro doesn't
// hash inline scripts itself, so its hash is added to the page's CSP here.
const introCheck = `(function (root) {
  var seen = false;
  try { seen = sessionStorage.getItem('silo-entered') === '1'; } catch (e) {}
  if (!seen && !root.dataset.focus && !matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('intro', 'mixing');
})(document.currentScript.parentElement);`;
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(introCheck).digest('base64')}`);
---

<div
  class:list={['myc', { focused: focus }]}
  data-myc
  data-focus={focus}
  data-home-url={routes.home}
  data-home-title={titleFor()}
>
  <script is:inline set:html={introCheck} />

  {/* The backdrops (DeCamp's map, the silo, the sandbox), drawn once and
      placed in each drawing with <use>. Their look is set here as
      attributes, coloured by currentColor, because selectors don't reach
      into a <use>. Only the outline draws itself in (pathLength 1). */}
  <svg class="myc-defs" width="0" height="0" aria-hidden="true">
    <defs>
      <g id="usmap">
        <path
          d={us.nation}
          pathLength="1"
          vector-effect="non-scaling-stroke"
          fill="currentColor"
          fill-opacity="0.03"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-opacity="0.6"
          stroke-dasharray="1 2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d={us.borders}
          vector-effect="non-scaling-stroke"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          stroke-opacity="0.25"
          stroke-dasharray="2 3"
          stroke-dashoffset="0"
        />
      </g>
      {
        arts.map(({ id, art }) => (
          <g id={id}>
            <path d={art.body} fill="currentColor" fill-opacity="0.05" stroke="none" />
            <path
              d={art.detail}
              vector-effect="non-scaling-stroke"
              fill="none"
              stroke="currentColor"
              stroke-width="0.8"
              stroke-opacity="0.35"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            {art.dots && (
              <path
                d={art.dots}
                vector-effect="non-scaling-stroke"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-opacity="0.45"
                stroke-linecap="round"
              />
            )}
            <path
              d={art.outline}
              pathLength="1"
              vector-effect="non-scaling-stroke"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-opacity="0.7"
              stroke-dasharray="1 2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </g>
        ))
      }
    </defs>
  </svg>

  {drawings.map((d) => <MyceliumNet {...d} open={focus} />)}

  {/* The front door: covers the drawing until the ring is entered. */}
  <button class="enter" type="button" aria-label={`Enter ${label.name}`}>
    <span class="enter-label">Enter ↘</span>
  </button>

  {/* Each silo's page (FocusPanels from the view), opened beside its colony. */}
  <slot />
</div>

<script>
  import { initMycelium } from './mycelium.client';
  initMycelium(document.querySelector<HTMLElement>('[data-myc]')!);
</script>

<style is:global>
  /* Global, but everything sits under .myc. Kept out of scoped styles so the
     drawing's elements don't each need a scoping attribute. */
  .myc {
    position: relative;
    margin-top: clamp(16px, 3cqw, 40px);
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .myc-defs {
    position: absolute;
    overflow: hidden;
  }

  .myc .net {
    display: block;
    width: 100%;
    max-width: 1200px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }
  /* the tall drawing is for phones */
  .myc .tall {
    display: none;
  }
  @media (max-width: 640px) {
    .myc .wide {
      display: none;
    }
    .myc .tall {
      display: block;
    }
  }

  .myc .web path,
  .myc .hyphae path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* a hidden line sits wholly in the gap, so its round ends can't show */
    stroke-dasharray: 1 2;
  }

  /* the underground, always there and faint, in the four silos' colours */
  .myc .web path {
    stroke: var(--c, #8c8c8c);
    stroke-dashoffset: 0;
  }

  /* a colony's own threads, hidden until it opens */
  .myc .hyphae path {
    stroke: var(--c);
    stroke-dashoffset: 1.5;
  }
  .myc .open .hyphae path {
    stroke-dashoffset: 0;
  }

  /* backdrops (DeCamp's map, Silo Recording's silo): hidden until the node
     opens. Colour and dash offset are inherited by the paths inside the <use>. */
  .myc .backdrop {
    color: var(--c);
    stroke-dashoffset: 0;
    visibility: hidden;
    opacity: 0;
  }
  .myc .open .backdrop {
    visibility: visible;
    opacity: 1;
  }

  /* project tips */
  .myc .tip {
    cursor: pointer;
    outline: none;
    visibility: hidden;
    opacity: 0;
  }
  .myc .open .tip {
    visibility: visible;
    opacity: 1;
  }
  .myc .tip-hit {
    fill: transparent;
  }
  .myc .tip-dot {
    fill: var(--c);
    stroke: var(--bg);
    stroke-width: 2;
    transition: r 0.15s;
  }
  .myc .tip.soon .tip-dot {
    fill: var(--bg);
    stroke: var(--c);
    stroke-width: 1.6;
  }
  .myc .tip-label {
    font-family: var(--f-mono);
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--c);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
  }
  .myc .tip.soon .tip-label {
    opacity: 0.6;
  }
  .myc .tip:hover .tip-dot,
  .myc .tip:focus-visible .tip-dot {
    r: 8;
  }
  .myc .tip:hover .tip-label,
  .myc .tip:focus-visible .tip-label {
    fill: var(--fg);
    opacity: 1;
  }

  /* ---------- the way in ---------- */
  /* Until the script has stacked the discs into the ring, show nothing. */
  .myc.intro:not(.primed) .node-body {
    opacity: 0;
  }
  /* While ringed, and until they land: overlapping discs mix like inks. */
  .myc.mixing .node-body {
    mix-blend-mode: screen;
  }
  .myc.intro .web,
  .myc.intro .node-label {
    opacity: 0;
  }
  .myc .node-label,
  .myc .web {
    transition: opacity 0.6s ease 0.9s;
  }
  .myc .enter {
    all: unset;
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    cursor: pointer;
  }
  /* no way in to show (returning visit, reduced motion, no JS) */
  .myc:not(.intro) .enter {
    display: none;
  }
  .myc .enter-label {
    margin-bottom: 1.5%;
    padding: 6px 12px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    font-variation-settings: 'wdth' 100;
    animation: myc-nudge 1.6s ease-in-out infinite;
  }
  .myc .enter:hover .enter-label,
  .myc .enter:focus-visible .enter-label {
    background: var(--fg);
    color: var(--bg);
  }
  .myc .enter:focus-visible {
    outline: none;
  }
  @keyframes myc-nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* the four nodes */
  .myc .node {
    cursor: pointer;
    outline: none;
  }
  .myc .node-hit {
    fill: transparent;
  }
  .myc .node-core {
    fill: var(--c);
  }
  .myc .node-grain {
    clip-path: circle(50%);
    opacity: 0.9;
    pointer-events: none;
  }
  .myc .node-mark {
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-box: fill-box;
    transform-origin: center;
  }
  .myc .node:hover .node-mark,
  .myc .node:focus-visible .node-mark {
    transform: scale(1.08);
  }
  .myc .node:focus-visible .node-core {
    stroke: var(--fg);
    stroke-width: 3;
  }
  .myc .node-label {
    font-family: var(--f-mono);
    font-size: 21px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 85;
    fill: var(--c);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
  }
  .myc .node:hover .node-label,
  .myc .node:focus-visible .node-label {
    fill: var(--fg);
  }

  /* bigger type on the tall (phone) drawing, which is shown smaller */
  .myc .tall .tip-label {
    font-size: 21px;
  }
  .myc .tall .node-label {
    font-size: 27px;
  }

  /* Fit the whole network on screen under the title and banner, however short
     the window. The title grows with the window's width (about 1.14 x its
     font size, which is (100vw - 60px) / 11), plus ~108px of banner and
     spacing. 1.613 is the drawing's width-to-height. */
  .myc .wide {
    max-width: min(1200px, calc((100svh - 108px - (100vw - 60px) * 0.1036) * 1.613));
    transition: max-width 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }

  /* ---------- focus: a silo's page beside its colony ---------- */
  .myc .dimmed {
    opacity: 0.07;
    pointer-events: none;
  }
  .myc .focus {
    position: absolute;
    top: 0;
    right: -16px;
    bottom: 0;
    z-index: 2;
    width: min(620px, 50%);
    padding: 14px 18px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--c);
    color: var(--bg);
    /* undo the big title type this sits inside */
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }
  .myc .focus[hidden] {
    display: none;
  }
  .myc .focus-back {
    all: unset;
    display: inline-block;
    margin-bottom: 10px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 100;
  }
  .myc .focus-back:hover {
    color: var(--fg);
  }
  .myc .focus-back:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: 2px;
  }
  /* phones: no room beside it, so the page sits under the zoomed colony */
  @media (max-width: 640px) {
    .myc .focus {
      position: relative;
      right: auto;
      width: auto;
      margin: 16px -16px -48px;
      scroll-margin-top: 56px;
    }
  }
  /* a project picked on the drawing flashes in the list */
  .myc .focus .item.flash {
    animation: myc-flash 1.6s ease-out;
  }
  @keyframes myc-flash {
    0%,
    30% {
      background: rgb(0 0 0 / 0.14);
    }
    100% {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .myc .enter-label {
      animation: none;
    }
  }
</style>
